<Project Sdk="Microsoft.NET.Sdk">

    <!-- A template package, not a library. Nothing here is compiled: the content folder is
         shipped verbatim and dotnet new writes it out with the names replaced. -->
    <PropertyGroup>
        <PackageType>Template</PackageType>
        <PackageId>Meows.Plugins.Template</PackageId>
        <!-- Pinned the same way as the contract, so a command line -p:Version aimed at the app
             cannot rename what this package is. -->
        <Version>0.4.0</Version>
        <PackageVersion>0.4.0</PackageVersion>
        <Title>Meows plugin template</Title>
        <Description>dotnet new template for a Meows plugin: project, plugin class, view, view model and string catalogues, ready to build.</Description>
        <Authors>Dennis</Authors>
        <PackageTags>dotnet-new;templates;meows;plugin;avalonia</PackageTags>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/Zeralius/Meows</PackageProjectUrl>
        <RepositoryUrl>https://github.com/Zeralius/Meows</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageReadmeFile>README.md</PackageReadmeFile>

        <TargetFramework>net10.0</TargetFramework>
        <IncludeContentInPack>true</IncludeContentInPack>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <ContentTargetFolders>content</ContentTargetFolders>
        <NoWarn>$(NoWarn);NU5128</NoWarn>
        <EnableDefaultItems>false</EnableDefaultItems>
    </PropertyGroup>

    <ItemGroup>
        <!-- Not in a folder called "content": ContentTargetFolders already puts these under
             content/ in the package, so a folder of that name here would land the template at
             content/content and one level deeper than dotnet new expects. -->
        <Content Include="MyPlugin\**\*" Exclude="MyPlugin\**\bin\**;MyPlugin\**\obj\**" />
        <None Include="README.md" Pack="true" PackagePath="\" />
        <None Include="..\LICENSE" Pack="true" PackagePath="\" />
    </ItemGroup>

</Project>
