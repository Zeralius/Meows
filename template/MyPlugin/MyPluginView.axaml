<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MyPlugin"
             x:Class="MyPlugin.MyPluginView"
             x:DataType="vm:MyPluginViewModel">

    <StackPanel Margin="20" Spacing="12">
        <TextBlock Text="MyPlugin" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Text="{Binding Status}" Opacity="0.7" TextWrapping="Wrap" />
        <Button Content="Say hello"
                Command="{Binding SayHelloCommand}"
                HorizontalAlignment="Left" />
    </StackPanel>

</UserControl>
