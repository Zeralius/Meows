<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Mews.ViewModels"
             x:Class="Mews.Views.PluginsView"
             x:DataType="vm:MainWindowViewModel">

    <DockPanel Margin="20">

        <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,18">
            <TextBlock Text="Plugins" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Opacity="0.55"
                       TextWrapping="Wrap"
                       Text="Activate a plugin to give it a tab. Deactivating closes the tab and releases it." />
            <TextBlock Opacity="0.35" FontSize="11" Text="{Binding ContractVersionText}" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Top"
                    Orientation="Horizontal"
                    Spacing="10"
                    Margin="0,0,0,14">
            <Button Content="Rescan plugins folder" Command="{Binding RescanCommand}" />
        </StackPanel>

        <TextBlock DockPanel.Dock="Top"
                   Margin="0,0,0,14"
                   Opacity="0.5"
                   TextWrapping="Wrap"
                   IsVisible="{Binding !HasPlugins}"
                   Text="Nothing found. Each plugin lives in its own subfolder of the plugins directory shown at the bottom of the window." />

        <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Plugins}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PluginEntryViewModel">
                        <Border Background="#1C1C22"
                                BorderBrush="#2E2E36"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16,13"
                                Margin="0,0,0,10">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Icon}"
                                           FontSize="22"
                                           VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Spacing="3">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="15" />
                                    <TextBlock Text="{Binding Description}" Opacity="0.6" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Origin}" Opacity="0.35" FontSize="11" />
                                    <TextBlock Text="{Binding Error}"
                                               Foreground="#FF7A7A"
                                               TextWrapping="Wrap"
                                               IsVisible="{Binding HasError}" />
                                    <TextBlock Text="{Binding IncompatibleReason}"
                                               Foreground="#FF9A6A"
                                               TextWrapping="Wrap"
                                               IsVisible="{Binding IsIncompatible}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center">
                                    <ToggleSwitch IsChecked="{Binding IsActivated}"
                                                  IsEnabled="{Binding IsCompatible}"
                                                  OnContent="Active"
                                                  OffContent="Inactive"
                                                  IsVisible="{Binding IsCompatible}" />
                                    <Border Background="#3A2418"
                                            BorderBrush="#6B4423"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="8,3"
                                            IsVisible="{Binding IsIncompatible}">
                                        <TextBlock Text="Incompatible" Foreground="#FFC168" FontSize="11" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </DockPanel>

</UserControl>
