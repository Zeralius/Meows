<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- xUnit1051 wants every CancellationToken.None replaced with the test context's token. These
         tests pass None on purpose: the code under test is what gets cancelled, not the test. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <!-- xunit v3, because the headless Avalonia runner below is built for it. -->
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <!-- Every plugin's view is built, shown and themed for real, without a window. Compiled bindings
         catch a typo; only a running view catches a template that does not resolve or a binding
         that throws when the data arrives. -->
    <PackageReference Include="Avalonia.Headless.XUnit" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- Real responses, captured from the live service. A fixture written by hand to match
       the parser only ever proves the parser agrees with itself. -->
  <ItemGroup>
    <None Include="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- A deliberately lopsided catalogue: German is missing a key English has, which is how the
       fallback gets tested. The real catalogues are checked for parity instead. -->
  <ItemGroup>
    <EmbeddedResource Include="Strings\Strings.*.json">
      <WithCulture>false</WithCulture>
      <LogicalName>$(AssemblyName).Strings.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Covers pure and filesystem logic. Anything needing an Avalonia render backend or a
       running dispatcher is deliberately out of scope, so this suite stays headless. -->
  <ItemGroup>
    <ProjectReference Include="..\Meows.Bot.Core\Meows.Bot.Core.csproj" />
    <ProjectReference Include="..\Meows.Media\Meows.Media.csproj" />
    <ProjectReference Include="..\Meows\Meows.csproj" />
    <ProjectReference Include="..\Meows.Plugins.TelegramPoster\Meows.Plugins.TelegramPoster.csproj" />
    <ProjectReference Include="..\Meows.Plugins.Purrge\Meows.Plugins.Purrge.csproj" />
      <ProjectReference Include="..\Meows.Plugins.Chonk\Meows.Plugins.Chonk.csproj" />
      <ProjectReference Include="..\Meows.Plugins.Litter\Meows.Plugins.Litter.csproj" />
      <ProjectReference Include="..\Meows.Plugins.Molt\Meows.Plugins.Molt.csproj" />
      <ProjectReference Include="..\Meows.Plugins.Saucer\Meows.Plugins.Saucer.csproj" />
      <ProjectReference Include="..\Meows.Plugins.Mouser\Meows.Plugins.Mouser.csproj" />
    <ProjectReference Include="..\Meows.Plugins.Kibble\Meows.Plugins.Kibble.csproj" />
    <ProjectReference Include="..\Meows.Plugins.Birdwatch\Meows.Plugins.Birdwatch.csproj" />
    <ProjectReference Include="..\Meows.Plugins.Tin\Meows.Plugins.Tin.csproj" />
    <ProjectReference Include="..\Meows.Plugins.Collar\Meows.Plugins.Collar.csproj" />
    <ProjectReference Include="..\Meows.Plugins.Scruff\Meows.Plugins.Scruff.csproj" />
    <ProjectReference Include="..\Meows.Plugins.Perch\Meows.Plugins.Perch.csproj" />
    <ProjectReference Include="..\Meows.Plugins.Portion\Meows.Plugins.Portion.csproj" />
    <ProjectReference Include="..\Meows.Plugins.Purr\Meows.Plugins.Purr.csproj" />
    <ProjectReference Include="..\Meows.Plugins.Kit\Meows.Plugins.Kit.csproj" />
  </ItemGroup>

</Project>