<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Mews.Plugins.Kibble.ViewModels"
             x:Class="Mews.Plugins.Kibble.Views.KibbleView"
             x:DataType="vm:KibbleViewModel"
             Focusable="True">

    <UserControl.Styles>
        <Style Selector="TextBlock.label">
            <Setter Property="Opacity" Value="0.5" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style Selector="TextBlock.section">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Opacity" Value="0.5" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="14,12,14,6" />
        </Style>
        <Style Selector="Border.panel">
            <Setter Property="Background" Value="#17171C" />
            <Setter Property="BorderBrush" Value="#2A2A32" />
        </Style>
        <Style Selector="Button.mode">
            <Setter Property="Background" Value="#1C1C22" />
            <Setter Property="BorderBrush" Value="#2E2E36" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.mode.on">
            <Setter Property="Background" Value="#24384A" />
            <Setter Property="BorderBrush" Value="#3E6C90" />
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="4" />
            <Setter Property="Margin" Value="0,0,4,4" />
            <Setter Property="CornerRadius" Value="5" />
        </Style>
        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#23232B" />
        </Style>
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="#24384A" />
            <Setter Property="BorderBrush" Value="#3E6C90" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </UserControl.Styles>

    <DockPanel>

        <Border DockPanel.Dock="Top"
                Background="#1C1C22"
                BorderBrush="#2A2A32"
                BorderThickness="0,0,0,1"
                Padding="14,10">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="{Binding SourceFolder}"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               IsVisible="{Binding HasSource}" />
                    <TextBlock Text="No folder open"
                               FontWeight="SemiBold"
                               Opacity="0.5"
                               IsVisible="{Binding !HasSource}" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Classes="label" Text="{Binding RemainingText}" />
                        <TextBlock Text="{Binding SelectionText}"
                                   FontSize="11"
                                   Foreground="#7FB0DA"
                                   IsVisible="{Binding IsBundle}" />
                        <TextBlock Classes="label" Text="{Binding SummaryText}" />
                        <TextBlock Classes="label" Text="{Binding StatusMessage}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Name="OpenFolderButton" Content="Open folder…" />
                    <Button Content="Refresh" Command="{Binding RefreshCommand}" />
                    <Button Content="Undo" Command="{Binding UndoCommand}" />
                    <Button Name="ChooseBotButton" Content="Bot folder…" />
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Top"
                Background="#3A1F22"
                BorderBrush="#5C2B30"
                BorderThickness="0,0,0,1"
                Padding="14,8"
                IsVisible="{Binding HasError}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#FFB4B4" TextWrapping="Wrap" />
        </Border>

        <Grid ColumnDefinitions="300,4,*,4,400">

            <!-- Destinations -->
            <Border Grid.Column="0" Classes="panel" BorderThickness="0,0,1,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Classes="section" Text="{Binding SendVerb}" />
                    <TextBlock DockPanel.Dock="Bottom"
                               Classes="label"
                               Margin="14,6,14,12"
                               TextWrapping="Wrap"
                               Text="Press 1 to 9 to send, space to skip. Ctrl click or shift click to pick several." />

                    <!-- What a send does when several are picked. -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="14,10,14,0" Spacing="4">
                        <TextBlock Classes="label" Text="Several picked go in as" />
                        <Grid ColumnDefinitions="*,6,*">
                            <Button Grid.Column="0"
                                    Classes="mode"
                                    Classes.on="{Binding IsComicMode}"
                                    Command="{Binding ChooseComicCommand}"
                                    Content="One comic" />
                            <Button Grid.Column="2"
                                    Classes="mode"
                                    Classes.on="{Binding IsFileMode}"
                                    Command="{Binding ChooseFilesCommand}"
                                    Content="Separate files" />
                        </Grid>
                    </StackPanel>
                    <ScrollViewer>
                        <ItemsControl ItemsSource="{Binding Destinations}" Margin="8,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:DestinationViewModel">
                                    <Button HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Background="#1C1C22"
                                            BorderBrush="#2E2E36"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="10,8"
                                            Margin="0,0,0,6"
                                            Command="{Binding $parent[UserControl].((vm:KibbleViewModel)DataContext).SendToCommand}"
                                            CommandParameter="{Binding}">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                            <Border Grid.Column="0"
                                                    Width="22" Height="22"
                                                    Background="#2A2A32"
                                                    CornerRadius="4"
                                                    VerticalAlignment="Center"
                                                    IsVisible="{Binding HasShortcut}">
                                                <TextBlock Text="{Binding ShortcutText}"
                                                           FontSize="11"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Spacing="1">
                                                <TextBlock Text="{Binding Name}"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding QueueText}" Classes="label" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding RunwayText}"
                                                       Foreground="{Binding Accent}"
                                                       FontSize="11"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Background="#22222A" ResizeDirection="Columns" />

            <!-- The folder you opened -->
            <DockPanel Grid.Column="2">
                <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,0,14,0">
                    <TextBlock Grid.Column="0" Classes="section" Text="WAITING TO BE SORTED" />
                    <ToggleButton Grid.Column="1"
                                  IsChecked="{Binding LazyLoad}"
                                  Content="In batches"
                                  FontSize="11"
                                  Padding="8,4"
                                  Margin="0,0,6,0"
                                  ToolTip.Tip="Build only a batch of tiles at a time. Much faster on a folder of thousands."
                                  VerticalAlignment="Center" />
                    <ComboBox Grid.Column="2"
                              ItemsSource="{Binding PageSizes}"
                              SelectedItem="{Binding PageSize}"
                              IsEnabled="{Binding LazyLoad}"
                              FontSize="11"
                              MinWidth="80"
                              Margin="0,0,6,0"
                              VerticalAlignment="Center" />
                    <ComboBox Grid.Column="3"
                              ItemsSource="{Binding SortOptions}"
                              SelectedItem="{Binding SelectedSort}"
                              FontSize="11"
                              MinWidth="150"
                              VerticalAlignment="Center" />
                </Grid>

                <TextBlock DockPanel.Dock="Top"
                           Margin="14,0,14,10"
                           Opacity="0.45"
                           TextWrapping="Wrap"
                           IsVisible="{Binding IsEmpty}"
                           Text="Nothing here. Open a folder to start, or you have cleared it out, which is the idea." />

                <Button DockPanel.Dock="Bottom"
                        Command="{Binding LoadMoreCommand}"
                        Content="{Binding LoadMoreText}"
                        IsVisible="{Binding HasMore}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Margin="8,0,8,8"
                        Padding="8,6"
                        FontSize="11" />

                <ListBox Name="FileGrid"
                         ItemsSource="{Binding Incoming}"
                         SelectedItem="{Binding Selected}"
                         SelectionMode="Multiple"
                         Background="Transparent"
                         BorderThickness="0"
                         Margin="8">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:IncomingFileViewModel">
                            <StackPanel Width="150" Spacing="4" ToolTip.Tip="{Binding FileName}">
                                <Border Width="150" Height="150"
                                        Background="#101014"
                                        CornerRadius="4"
                                        ClipToBounds="True">
                                    <Panel>
                                        <Image Source="{Binding Thumbnail}"
                                               Stretch="UniformToFill"
                                               IsVisible="{Binding HasThumbnail}" />
                                        <TextBlock Text="{Binding KindGlyph}"
                                                   FontSize="26"
                                                   Opacity="0.35"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   IsVisible="{Binding ShowGlyph}" />
                                        <Border Background="#CC5C2B30"
                                                CornerRadius="3"
                                                Padding="4,1"
                                                Margin="4"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                IsVisible="{Binding !IsPostable}">
                                            <TextBlock Text="THE BOT SKIPS THIS" FontSize="9" />
                                        </Border>
                                        <!-- Which page this will be inside the comic. -->
                                        <Border Background="#E63E6C90"
                                                CornerRadius="12"
                                                Width="24" Height="24"
                                                Margin="4"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                IsVisible="{Binding HasPageNumber}">
                                            <TextBlock Text="{Binding PageText}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="White"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                    </Panel>
                                </Border>
                                <TextBlock Text="{Binding FileName}"
                                           FontSize="10"
                                           MaxWidth="150"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <GridSplitter Grid.Column="3" Background="#22222A" ResizeDirection="Columns" />

            <!-- Preview -->
            <Border Grid.Column="4" Classes="panel" BorderThickness="1,0,0,0">
                <!-- Rows rather than a stack in a scroller. The picture gets the leftover
                     row, so widening this column or growing the window makes it bigger,
                     instead of it sitting at a fixed size with space around it. -->
                <Grid RowDefinitions="Auto,*,Auto" Margin="16,12">

                    <TextBlock Grid.Row="0"
                               Text="Preview"
                               FontWeight="SemiBold"
                               FontSize="13"
                               Margin="0,0,0,8" />

                    <Border Grid.Row="1"
                            Background="#101014"
                            CornerRadius="6"
                            MinHeight="160"
                            Padding="6"
                            IsVisible="{Binding HasSelection}">
                        <Panel>
                            <Image Source="{Binding PreviewImage}"
                                   Stretch="Uniform"
                                   IsVisible="{Binding HasPreviewImage}" />
                            <TextBlock Text="No inline preview for this file type"
                                       Opacity="0.35"
                                       FontSize="11"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       IsVisible="{Binding !HasPreviewImage}" />
                        </Panel>
                    </Border>

                    <!-- Capped so a tall comic box cannot crowd the picture out entirely on a
                         short window. Past that it scrolls rather than squeezing the preview. -->
                    <ScrollViewer Grid.Row="2" MaxHeight="420" Margin="0,8,0,0">
                    <StackPanel Spacing="8">

                        <StackPanel Spacing="2" IsVisible="{Binding HasSelection}">
                            <TextBlock Text="{Binding Selected.FileName}" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Classes="label" Text="{Binding Selected.SizeText}" />
                                <TextBlock Classes="label" Text="{Binding Selected.ModifiedText}" />
                            </StackPanel>
                        </StackPanel>

                        <Border Background="#3A2418"
                                BorderBrush="#6B4423"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10,8"
                                IsVisible="{Binding IsBlocked}">
                            <TextBlock Text="{Binding BlockedReason}"
                                       Foreground="#FFC168"
                                       TextWrapping="Wrap"
                                       FontSize="11" />
                        </Border>

                        <Border Background="#1B2A38"
                                BorderBrush="#31536E"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10,8"
                                IsVisible="{Binding IsBundle}">
                            <StackPanel Spacing="6">
                                <TextBlock Text="{Binding BundleText}"
                                           TextWrapping="Wrap"
                                           FontSize="11"
                                           Foreground="#BBD6EC" />
                                <StackPanel Spacing="6" IsVisible="{Binding IsComicMode}">
                                    <TextBlock Classes="label" Text="Name from" />
                                    <ComboBox ItemsSource="{Binding NamingOptions}"
                                              SelectedItem="{Binding SelectedNaming}"
                                              FontSize="11"
                                              HorizontalAlignment="Stretch" />
                                    <TextBlock Classes="label" Text="Comic name" />
                                    <TextBox Text="{Binding ArchiveName}"
                                             PlaceholderText="comic"
                                             FontSize="12" />
                                    <TextBlock Classes="label" Text="Page order" />
                                    <ComboBox ItemsSource="{Binding PageOrderOptions}"
                                              SelectedItem="{Binding SelectedPageOrder}"
                                              FontSize="11"
                                              HorizontalAlignment="Stretch" />
                                    <TextBlock Classes="label"
                                               TextWrapping="Wrap"
                                               Text="Saved as .cbz. The number on each tile is the page it will be." />
                                </StackPanel>
                                <TextBlock Classes="label"
                                           TextWrapping="Wrap"
                                           IsVisible="{Binding IsFileMode}"
                                           Text="They go in one by one, in the order the grid is showing, so the sort above decides it." />
                            </StackPanel>
                        </Border>

                        <Button Content="Skip this one"
                                Command="{Binding SkipCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center" />

                        <TextBlock Classes="label" Text="Queue order" Margin="0,10,0,0" />
                        <ComboBox ItemsSource="{Binding StampOptions}"
                                  SelectedItem="{Binding SelectedStamp}"
                                  HorizontalAlignment="Stretch" />
                        <TextBlock Text="{Binding StampHint}" Classes="label" TextWrapping="Wrap" />

                        <TextBlock Classes="label" Margin="0,10,0,0" TextWrapping="Wrap"
                                   Text="Files move rather than copy. Undo puts the last one back where it came from." />
                        <TextBlock Text="{Binding BotRootText}" Classes="label" TextWrapping="Wrap" />

                    </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

        </Grid>

    </DockPanel>

</UserControl>
