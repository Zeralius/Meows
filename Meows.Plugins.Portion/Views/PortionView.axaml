<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Meows.Plugins.Portion.ViewModels"
             xmlns:m="using:Meows.Plugins.Abstractions"
             x:Class="Meows.Plugins.Portion.Views.PortionView"
             x:DataType="vm:PortionViewModel">

    <UserControl.Styles>
        <Style Selector="TextBlock.label">
            <Setter Property="Opacity" Value="0.5" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style Selector="TextBlock.section">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Opacity" Value="0.5" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="14,12,14,6" />
        </Style>
        <Style Selector="Border.panel">
            <Setter Property="Background" Value="{DynamicResource MeowsBase}" />
            <Setter Property="BorderBrush" Value="{DynamicResource MeowsLineSoft}" />
        </Style>
        <Style Selector="Button.row">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.row:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource MeowsHeader}" />
        </Style>
        <Style Selector="Button.row.selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource MeowsSelection}" />
            <Setter Property="BorderBrush" Value="{DynamicResource MeowsSelectionLine}" />
        </Style>
        <Style Selector="Border.mark">
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="5,1" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.mark TextBlock">
            <Setter Property="FontSize" Value="9" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
        </Style>
    </UserControl.Styles>

    <DockPanel>

        <Border DockPanel.Dock="Top"
                Background="{DynamicResource MeowsCard}"
                BorderBrush="{DynamicResource MeowsLineSoft}"
                BorderThickness="0,0,0,1"
                Padding="14,10">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="{Binding BotRootText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Status}" Classes="label" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Name="ChooseBotButton" Command="{Binding ChooseBotCommand}" Content="{m:Tr portion.botfolder}" />
                    <Button Content="{m:Tr portion.scan}" Command="{Binding ScanCommand}" />
                    <Button Content="{m:Tr portion.cancel}" Command="{Binding CancelCommand}" />
                    <Button Content="{m:Tr portion.shrinkall}"
                            Command="{Binding ShrinkAllCommand}"
                            FontWeight="SemiBold"
                            ToolTip.Tip="{m:Tr portion.shrinkall.hint}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Top"
                Background="{DynamicResource MeowsDanger}"
                BorderBrush="{DynamicResource MeowsDangerLine}"
                BorderThickness="0,0,0,1"
                Padding="14,8"
                IsVisible="{Binding HasError}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource MeowsDangerText}" TextWrapping="Wrap" />
        </Border>

        <Grid ColumnDefinitions="*,4,380">

            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Classes="section" Text="{m:Tr portion.list}" />

                <Border DockPanel.Dock="Top"
                        Margin="10,0,10,10"
                        Background="{DynamicResource MeowsInfo}"
                        BorderBrush="{DynamicResource MeowsInfoLine}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,10"
                        IsVisible="{Binding AllClear}">
                    <TextBlock Text="{m:Tr portion.allclear}" Foreground="{DynamicResource MeowsGoodText}" FontWeight="SemiBold" TextWrapping="Wrap" />
                </Border>

                <TextBlock DockPanel.Dock="Top"
                           Margin="14,0,14,10"
                           Opacity="0.45"
                           TextWrapping="Wrap"
                           IsVisible="{Binding IsScanning}"
                           Text="{m:Tr portion.empty}" />

                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding Heavies}" Margin="10,0,10,10">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:HeavyViewModel">
                                <Button Classes="row"
                                        Classes.selected="{Binding IsSelected}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="8,5"
                                        Margin="0,0,0,2"
                                        Command="{Binding $parent[UserControl].((vm:PortionViewModel)DataContext).SelectCommand}"
                                        CommandParameter="{Binding}">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                                        <Border Grid.Column="0"
                                                Width="44" Height="44"
                                                Background="{DynamicResource MeowsSunken}"
                                                CornerRadius="3"
                                                ClipToBounds="True">
                                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" IsVisible="{Binding HasThumbnail}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                            <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding GroupName}" Classes="label" />
                                            <TextBlock Text="{Binding TroubleText}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource MeowsWarnText}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Outcome}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource MeowsGoodText}"
                                                       IsVisible="{Binding HasOutcome}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                            <Border Classes="mark" Background="{DynamicResource MeowsBadge}" IsVisible="{Binding IsComic}">
                                                <TextBlock Text="{m:Tr portion.mark.comic}" />
                                            </Border>
                                            <Border Classes="mark" Background="{DynamicResource MeowsVeil}" IsVisible="{Binding IsVideo}">
                                                <TextBlock Text="{m:Tr portion.mark.video}" />
                                            </Border>
                                            <Border Classes="mark" Background="{DynamicResource MeowsDangerStrong}" IsVisible="{Binding WillFail}">
                                                <TextBlock Text="{m:Tr portion.mark.fails}" />
                                            </Border>
                                            <Border Classes="mark" Background="{DynamicResource MeowsWarnLine}" IsVisible="{Binding IsOnlyANote}">
                                                <TextBlock Text="{m:Tr portion.mark.note}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Grid.Column="3" Text="{Binding SizeText}" FontWeight="SemiBold" VerticalAlignment="Center" MinWidth="64" TextAlignment="Right" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>

            <GridSplitter Grid.Column="1" Background="{DynamicResource MeowsRaised}" ResizeDirection="Columns" />

            <Border Grid.Column="2" Classes="panel" BorderThickness="1,0,0,0">
                <ScrollViewer Padding="16,12">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{m:Tr portion.selected}" FontWeight="SemiBold" FontSize="13" />
                        <TextBlock Text="{m:Tr portion.nothingselected}" Classes="label" IsVisible="{Binding !HasSelection}" />

                        <StackPanel Spacing="8" IsVisible="{Binding HasSelection}">
                            <Border Background="{DynamicResource MeowsSunken}" CornerRadius="6" MinHeight="160" Padding="6">
                                <Panel>
                                    <Image Source="{Binding Preview}" Stretch="Uniform" MaxHeight="400" IsVisible="{Binding HasPreview}" />
                                    <TextBlock Text="{m:Tr portion.nopreview}"
                                               Opacity="0.35"
                                               FontSize="11"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               IsVisible="{Binding !HasPreview}" />
                                </Panel>
                            </Border>
                            <TextBlock Text="{Binding Selected.FileName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Selected.GroupName}" Classes="label" />
                            <TextBlock Text="{Binding Selected.TroubleText}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource MeowsWarnText}" />
                            <TextBlock Text="{Binding Selected.RemedyText}" FontSize="12" TextWrapping="Wrap" />

                            <Button Content="{m:Tr portion.shrink}"
                                    Command="{Binding ShrinkSelectedCommand}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center" />
                            <Button Content="{m:Tr portion.hold}"
                                    Command="{Binding HoldCommand}"
                                    IsVisible="{Binding Selected.WillFail}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center" />
                            <TextBlock Text="{m:Tr portion.hold.note}"
                                       Classes="label"
                                       TextWrapping="Wrap"
                                       IsVisible="{Binding Selected.WillFail}" />
                            <Button Content="{m:Tr portion.explore}"
                                    Command="{Binding RevealCommand}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center" />
                        </StackPanel>

                        <Border Background="{DynamicResource MeowsInset}" CornerRadius="6" Padding="10,8">
                            <TextBlock Text="{m:Tr portion.howitworks}" TextWrapping="Wrap" FontSize="11" Opacity="0.7" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

        </Grid>

    </DockPanel>

</UserControl>
