<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Meows.Plugins.Molt.ViewModels"
             xmlns:m="using:Meows.Plugins.Abstractions"
             x:Class="Meows.Plugins.Molt.Views.MoltView"
             x:DataType="vm:MoltViewModel">

    <UserControl.Styles>
        <Style Selector="TextBlock.label">
            <Setter Property="Opacity" Value="0.5" />
            <Setter Property="FontSize" Value="11" />
        </Style>
    </UserControl.Styles>

    <DockPanel>

        <Border DockPanel.Dock="Top"
                Background="{DynamicResource MeowsCard}"
                BorderBrush="{DynamicResource MeowsLineSoft}"
                BorderThickness="0,0,0,1"
                Padding="14,10">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="{m:Tr molt.title}" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Classes="label" Text="{Binding TotalText}" />
                        <TextBlock Classes="label" Text="{Binding PickedText}" />
                        <TextBlock Classes="label" Text="{Binding Status}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Name="PickBuildRootButton" Content="{m:Tr molt.projects}" FontSize="11" />
                    <Button Content="{m:Tr molt.rescan}" Command="{Binding ScanCommand}" IsVisible="{Binding !IsScanning}" />
                    <Button Content="{m:Tr molt.stop}" Command="{Binding CancelCommand}" IsVisible="{Binding IsScanning}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Top"
                Background="{DynamicResource MeowsDanger}"
                BorderBrush="{DynamicResource MeowsDangerLine}"
                BorderThickness="0,0,0,1"
                Padding="14,8"
                IsVisible="{Binding HasError}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource MeowsDangerText}" TextWrapping="Wrap" />
        </Border>

        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource MeowsCard}"
                BorderBrush="{DynamicResource MeowsLineSoft}"
                BorderThickness="0,1,0,0"
                Padding="14,10">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                <StackPanel Grid.Column="0" Spacing="4">
                    <CheckBox Content="{m:Tr molt.permanent}"
                              IsChecked="{Binding Permanent}"
                              FontSize="11" />
                    <TextBlock Text="{Binding ModeText}" Classes="label" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Content="{m:Tr molt.pickall}" Command="{Binding PickAllCommand}" FontSize="11" />
                    <Button Content="{m:Tr molt.picknone}" Command="{Binding PickNoneCommand}" FontSize="11" />
                    <Button Content="{m:Tr molt.shed}"
                            Command="{Binding ShedCommand}"
                            Background="{DynamicResource MeowsDanger}"
                            BorderBrush="{DynamicResource MeowsDangerLine}" />
                </StackPanel>
            </Grid>
        </Border>

        <Panel>
            <ScrollViewer Padding="14,12">
                <StackPanel Spacing="8">

                    <TextBlock Classes="label"
                               TextWrapping="Wrap"
                               Text="{m:Tr molt.note.excluded}" />

                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SheddableViewModel">
                                <Border Background="{DynamicResource MeowsBase}"
                                        BorderBrush="{DynamicResource MeowsLineSoft}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="12,10"
                                        Margin="0,0,0,8">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <CheckBox Grid.Column="0"
                                                  IsChecked="{Binding IsPicked}"
                                                  VerticalAlignment="Top" />
                                        <StackPanel Grid.Column="1" Spacing="3">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding What}" Classes="label" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Cost}"
                                                       Foreground="{DynamicResource MeowsWarnText}"
                                                       FontSize="11"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Where}"
                                                       Opacity="0.35"
                                                       FontSize="10"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding SizeText}"
                                                       FontWeight="SemiBold"
                                                       FontSize="15"
                                                       HorizontalAlignment="Right" />
                                            <TextBlock Text="{Binding CountText}"
                                                       Classes="label"
                                                       HorizontalAlignment="Right" />
                                            <Button Content="{m:Tr molt.open}"
                                                    FontSize="10"
                                                    Padding="6,2"
                                                    HorizontalAlignment="Right"
                                                    Command="{Binding $parent[UserControl].((vm:MoltViewModel)DataContext).ExploreCommand}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Classes="label"
                               TextWrapping="Wrap"
                               IsVisible="{Binding !HasBuildRoot}"
                               Text="{m:Tr molt.note.pickroot}" />

                </StackPanel>
            </ScrollViewer>

            <Border IsVisible="{Binding IsAsking}" Background="{DynamicResource MeowsVeil}">
                <Border Background="{DynamicResource MeowsCard}"
                        BorderBrush="{DynamicResource MeowsDangerLine}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20,16"
                        MaxWidth="460"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{Binding ConfirmPrompt}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding ConfirmDetail}" Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
                        <Grid ColumnDefinitions="*,8,*">
                            <Button Grid.Column="0"
                                    Content="{m:Tr molt.cancel}"
                                    Command="{Binding CancelShedCommand}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center" />
                            <Button Grid.Column="2"
                                    Content="{m:Tr molt.goahead}"
                                    Command="{Binding ConfirmCommand}"
                                    Background="{DynamicResource MeowsDanger}"
                                    BorderBrush="{DynamicResource MeowsDangerLine}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Border>
        </Panel>

    </DockPanel>

</UserControl>
