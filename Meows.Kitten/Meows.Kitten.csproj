<Project Sdk="Microsoft.NET.Sdk">

    <!-- A developer tool, not a plugin. It lives in the solution so it builds with everything
         else, and nothing in the release workflow looks at it: that only stages Meows.Plugins.* -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <RootNamespace>Meows.Kitten</RootNamespace>
    </PropertyGroup>

</Project>
