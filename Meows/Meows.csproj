<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <ApplicationIcon>Assets\meows.ico</ApplicationIcon>

        <!-- The app version. Moves independently of the plugin contract version;
             see the versioning section in README.md. -->
        <Version>5.3.0</Version>
        <!-- Where the shell looks for its own newer release, the same way it does for a plugin. -->
        <RepositoryUrl>https://github.com/Zeralius/Meows</RepositoryUrl>
        <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Avalonia" Version="12.1.1" />
      <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
      <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
      <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
      <!-- The shared store. The shell carries SQLite once, for every plugin, and plugins reach it
           through the host rather than shipping a second copy. -->
      <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
      <!-- The native SQLite underneath it, lifted past CVE-2025-6965 (GHSA-2m69-gcr7-jv3q).
           Microsoft.Data.Sqlite 10.0.0 brings SQLitePCLRaw 2.1.11, whose bundled SQLite is older
           than the 3.50.2 that fixed it. This package is native binaries with no dependencies,
           so raising it here changes the SQLite that is loaded and nothing about the provider
           or the API. Stays on the 2.x line the provider expects; 3.x is the provider's own
           major version and would be a different change. Remove it once Microsoft.Data.Sqlite
           brings a fixed one itself; SqliteVersionTests says if the pin is ever lost. -->
      <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.13" />
      <!-- Reach over SFTP. The shell owns the connection so a plugin only ever names a place on
           the server; a share or a mapped drive needs nothing but the file system. -->
      <PackageReference Include="SSH.NET" Version="2026.0.0" />
    </ItemGroup>

    <!-- One file per language, merged into the string table at startup. Plugins ship their own
         the same way and the shell reads them when the plugin is switched on.

         WithCulture and LogicalName are both load bearing. MSBuild reads the middle part of
         Strings.de.json as a culture and, left alone, files it under a de satellite assembly and
         strips the code out of the name, so both languages end up called Strings.json and neither
         is in the assembly the shell reads. -->
    <ItemGroup>
      <EmbeddedResource Include="Strings\Strings.*.json">
        <WithCulture>false</WithCulture>
        <LogicalName>$(AssemblyName).Strings.%(Filename)%(Extension)</LogicalName>
      </EmbeddedResource>
    </ItemGroup>

    <!-- The cat, drawn as a handful of shapes so it is ours, at the sizes Windows asks for. The
         two tray icons are PNGs because the tray scales them itself; the exe and the window take
         the multi-size ICO. -->
    <ItemGroup>
      <AvaloniaResource Include="Assets\**" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Meows.Plugins.Abstractions\Meows.Plugins.Abstractions.csproj" />
    </ItemGroup>

</Project>
