<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Meows.ViewModels"
             xmlns:svc="using:Meows.Services"
             xmlns:m="using:Meows.Plugins.Abstractions"
             x:Class="Meows.Views.HomeView"
             x:DataType="vm:HomeViewModel">

    <UserControl.Styles>
        <Style Selector="TextBlock.heading">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.55" />
            <Setter Property="Margin" Value="2,0,0,8" />
        </Style>
        <Style Selector="TextBlock.trouble">
            <Setter Property="Foreground" Value="{DynamicResource MeowsDangerText}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="TextBlock.severity">
            <Setter Property="Foreground" Value="{DynamicResource MeowsInfoText}" />
        </Style>
        <Style Selector="TextBlock.severity.warning">
            <Setter Property="Foreground" Value="{DynamicResource MeowsWarnText}" />
        </Style>
        <Style Selector="TextBlock.severity.error">
            <Setter Property="Foreground" Value="{DynamicResource MeowsDangerStrong}" />
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource MeowsCard}" />
            <Setter Property="BorderBrush" Value="{DynamicResource MeowsLine}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style Selector="Button.small">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
    </UserControl.Styles>

    <DockPanel Margin="20">

        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,18">
            <StackPanel Spacing="4">
                <TextBlock Text="{m:Tr home.title}" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="{Binding SinceText}" Opacity="0.55" />
                <TextBlock Text="{Binding WatchesText}"
                           Opacity="0.55"
                           FontSize="12"
                           Classes.trouble="{Binding WatchesInTrouble}" />
            </StackPanel>
            <Button Grid.Column="1"
                    Classes="small"
                    VerticalAlignment="Top"
                    Content="{m:Tr home.refresh}"
                    Command="{Binding RefreshCommand}" />
        </Grid>

        <ScrollViewer>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="18">

                <StackPanel Grid.Column="0">

                    <!-- What is up: the notifications, with their verbs, as the panel shows them. -->
                    <TextBlock Classes="heading" Text="{m:Tr home.notifications}" />
                    <TextBlock Opacity="0.4"
                               FontSize="11"
                               Margin="2,0,0,14"
                               IsVisible="{Binding !HasNotifications}"
                               Text="{m:Tr shell.notifications.empty}" />
                    <ItemsControl ItemsSource="{Binding Notifications}" Margin="0,0,0,12">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="svc:NotificationItem">
                                <Border Classes="card">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Glyph}"
                                                   Classes="severity"
                                                   Classes.warning="{Binding IsWarning}"
                                                   Classes.error="{Binding IsError}"
                                                   VerticalAlignment="Top" />
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Message}"
                                                       Opacity="0.7"
                                                       FontSize="11"
                                                       TextWrapping="Wrap"
                                                       IsVisible="{Binding HasMessage}" />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding SourceName}" Opacity="0.4" FontSize="10" />
                                                <TextBlock Text="{Binding TimeText}" Opacity="0.4" FontSize="10" />
                                            </StackPanel>
                                        </StackPanel>
                                        <ItemsControl Grid.Column="2" ItemsSource="{Binding Buttons}" IsVisible="{Binding HasAction}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" Spacing="6" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="svc:NotificationButton">
                                                    <Button Classes="small"
                                                            Content="{Binding Label}"
                                                            Command="{Binding $parent[UserControl].((vm:HomeViewModel)DataContext).InvokeNotificationCommand}"
                                                            CommandParameter="{Binding}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- What is running right now. -->
                    <TextBlock Classes="heading" Text="{m:Tr home.running}" IsVisible="{Binding HasRunning}" />
                    <ItemsControl ItemsSource="{Binding Running}" Margin="0,0,0,12" IsVisible="{Binding HasRunning}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="svc:BackgroundTaskItem">
                                <Border Classes="card">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Status}" Opacity="0.65" FontSize="11" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding SourceName}" Opacity="0.4" FontSize="10" />
                                        <ProgressBar Height="4"
                                                     Minimum="0"
                                                     Maximum="100"
                                                     Value="{Binding ProgressPercent}"
                                                     IsIndeterminate="{Binding !HasProgress}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>

                <StackPanel Grid.Column="1">

                    <!-- Each plugin that is on, and its last line, with the tab a click away. -->
                    <TextBlock Classes="heading" Text="{m:Tr home.plugins}" />
                    <TextBlock Opacity="0.4"
                               FontSize="11"
                               Margin="2,0,0,14"
                               IsVisible="{Binding !HasPlugins}"
                               Text="{m:Tr home.plugins.none}" />
                    <ItemsControl ItemsSource="{Binding Plugins}" Margin="0,0,0,12">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:HomePluginLine">
                                <Border Classes="card">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Icon}"
                                                   FontFamily="Segoe UI Emoji"
                                                   VerticalAlignment="Top" />
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <!-- The plugin's own line first, when it has one; the shell's below it. -->
                                            <TextBlock Text="{Binding GlanceText}"
                                                       Opacity="0.85"
                                                       FontSize="12"
                                                       TextWrapping="Wrap"
                                                       IsVisible="{Binding HasGlance}"
                                                       Classes.trouble="{Binding GlanceIsTrouble}" />
                                            <TextBlock Text="{Binding Health}"
                                                       Opacity="0.55"
                                                       FontSize="11"
                                                       TextWrapping="Wrap"
                                                       Classes.trouble="{Binding IsTrouble}" />
                                        </StackPanel>
                                        <Button Grid.Column="2"
                                                Classes="small"
                                                VerticalAlignment="Top"
                                                Content="{m:Tr home.open}"
                                                Command="{Binding OpenCommand}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- What the plugins did since the window was last hidden. -->
                    <TextBlock Classes="heading" Text="{m:Tr home.recent}" />
                    <TextBlock Opacity="0.4"
                               FontSize="11"
                               Margin="2,0,0,14"
                               IsVisible="{Binding !HasRecent}"
                               Text="{m:Tr home.recent.none}" />
                    <ItemsControl ItemsSource="{Binding Recent}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:HistoryLineViewModel">
                                <Border Classes="card" Padding="10,6">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                        <TextBlock Grid.Column="0" Text="{Binding When}" Opacity="0.4" FontSize="11" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Spacing="1">
                                            <TextBlock Text="{Binding ShortSubject}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{Binding Plugin}" Opacity="0.4" FontSize="10" />
                                                <TextBlock Text="{Binding Kind}" Opacity="0.4" FontSize="10" />
                                                <TextBlock Text="{Binding Detail}" Opacity="0.4" FontSize="10" IsVisible="{Binding HasDetail}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </StackPanel>
                                        <Button Grid.Column="2"
                                                Classes="small"
                                                VerticalAlignment="Center"
                                                Content="{m:Tr home.reveal}"
                                                IsVisible="{Binding IsPath}"
                                                Command="{Binding $parent[UserControl].((vm:HomeViewModel)DataContext).RevealCommand}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </Grid>
        </ScrollViewer>

    </DockPanel>

</UserControl>
