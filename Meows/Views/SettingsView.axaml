<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Meows.ViewModels"
             xmlns:m="using:Meows.Plugins.Abstractions"
             x:Class="Meows.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <UserControl.Styles>
        <Style Selector="Border.section">
            <Setter Property="Background" Value="{DynamicResource MeowsCard}" />
            <Setter Property="BorderBrush" Value="{DynamicResource MeowsLine}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="18,15" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <Style Selector="TextBlock.heading">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="15" />
        </Style>
        <Style Selector="TextBlock.hint">
            <Setter Property="Opacity" Value="0.55" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer>
        <StackPanel Margin="20" MaxWidth="720" HorizontalAlignment="Left">

            <StackPanel Spacing="4" Margin="0,0,0,18">
                <TextBlock Text="{m:Tr settings.title}" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Classes="hint" Text="{m:Tr settings.subtitle}" />
            </StackPanel>

            <Border Classes="section">
                <StackPanel Spacing="10">
                    <TextBlock Classes="heading" Text="{m:Tr settings.theme}" />
                    <TextBlock Classes="hint" Text="{m:Tr settings.theme.hint}" />
                    <StackPanel Spacing="4" Margin="0,4,0,0">
                        <RadioButton GroupName="theme"
                                     Content="{m:Tr settings.theme.system}"
                                     IsChecked="{Binding IsThemeSystem}" />
                        <RadioButton GroupName="theme"
                                     Content="{m:Tr settings.theme.light}"
                                     IsChecked="{Binding IsThemeLight}" />
                        <RadioButton GroupName="theme"
                                     Content="{m:Tr settings.theme.dark}"
                                     IsChecked="{Binding IsThemeDark}" />
                    </StackPanel>
                    <TextBlock Classes="heading" Text="{m:Tr settings.accent}" Margin="0,6,0,0" />
                    <TextBlock Classes="hint" Text="{m:Tr settings.accent.hint}" />
                    <ComboBox ItemsSource="{Binding Accents}"
                              SelectedItem="{Binding SelectedAccent}"
                              HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:AccentChoice">
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Classes="heading" Text="{m:Tr settings.scheme}" Margin="0,8,0,0" />
                    <TextBlock Classes="hint" Text="{m:Tr settings.scheme.hint}" />
                    <ComboBox ItemsSource="{Binding Schemes}"
                              SelectedItem="{Binding SelectedScheme}"
                              HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:AppearanceSchemeChoice">
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Border Background="{Binding Preview.Background}"
                            BorderBrush="{Binding Preview.Border}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12"
                            Margin="0,4,0,0">
                        <StackPanel Spacing="7">
                            <TextBlock Text="{m:Tr settings.scheme.preview}"
                                       Foreground="{Binding Preview.Foreground}"
                                       FontWeight="SemiBold" />
                            <Border Background="{Binding Preview.Panel}"
                                    BorderBrush="{Binding Preview.Border}"
                                    BorderThickness="1"
                                    Padding="8">
                                <StackPanel Spacing="6">
                                    <Border Background="{Binding Preview.Card}"
                                            BorderBrush="{Binding Preview.Border}"
                                            BorderThickness="1"
                                            Padding="8">
                                        <TextBlock Text="{m:Tr settings.scheme.sample}"
                                                   Foreground="{Binding Preview.Foreground}" />
                                    </Border>
                                    <Border Background="{Binding Preview.Selection}"
                                            Padding="6">
                                        <TextBlock Text="{m:Tr settings.scheme.selected}"
                                                   Foreground="{Binding Preview.SelectionText}" />
                                    </Border>
                                </StackPanel>
                            </Border>
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <Border Background="{Binding Preview.Info}"
                                        BorderBrush="{Binding Preview.Accent}"
                                        BorderThickness="1"
                                        Padding="6">
                                    <TextBlock Text="{m:Tr settings.scheme.info}"
                                               Foreground="{Binding Preview.InfoText}" />
                                </Border>
                                <Border Background="{Binding Preview.Warning}" Padding="6">
                                    <TextBlock Text="{m:Tr settings.scheme.warning}"
                                               Foreground="{Binding Preview.WarningText}" />
                                </Border>
                                <Border Background="{Binding Preview.Danger}" Padding="6">
                                    <TextBlock Text="{m:Tr settings.scheme.danger}"
                                               Foreground="{Binding Preview.DangerText}" />
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <TextBlock Classes="hint"
                               Foreground="{DynamicResource MeowsWarnText}"
                               Text="{Binding ContrastNotice}"
                               IsVisible="{Binding HasContrastNotice}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="{m:Tr settings.scheme.customize}"
                                Command="{Binding CustomizeCommand}"
                                IsVisible="{Binding !IsCustomScheme}" />
                        <Button Content="{m:Tr settings.scheme.reset}"
                                Command="{Binding ResetAppearanceCommand}" />
                    </StackPanel>
                    <StackPanel Spacing="8" IsVisible="{Binding IsCustomScheme}">
                        <TextBlock Classes="hint" Text="{m:Tr settings.scheme.edit.hint}" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <RadioButton GroupName="scheme-variant"
                                         Content="{m:Tr settings.theme.light}"
                                         IsChecked="{Binding EditLight}" />
                            <RadioButton GroupName="scheme-variant"
                                         Content="{m:Tr settings.theme.dark}"
                                         IsChecked="{Binding EditDark}" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Colours}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:AppearanceColourRow">
                                    <Grid ColumnDefinitions="135,28,112,*" ColumnSpacing="8" Margin="0,0,0,6">
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center" />
                                        <Border Grid.Column="1"
                                                Width="24" Height="24"
                                                Background="{Binding Swatch}"
                                                BorderBrush="{DynamicResource MeowsLine}"
                                                BorderThickness="1" />
                                        <TextBox Grid.Column="2"
                                                 Text="{Binding Hex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding ErrorText}"
                                                   IsVisible="{Binding IsInvalid}"
                                                   Foreground="{DynamicResource MeowsDangerText}"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Classes="section">
                <StackPanel Spacing="10">
                    <TextBlock Classes="heading" Text="{m:Tr settings.tabsize}" />
                    <TextBlock Classes="hint" Text="{m:Tr settings.tabsize.hint}" />
                    <StackPanel Spacing="4" Margin="0,4,0,0">
                        <RadioButton GroupName="tabsize"
                                     Content="{m:Tr settings.tabsize.compact}"
                                     IsChecked="{Binding IsTabsCompact}" />
                        <RadioButton GroupName="tabsize"
                                     Content="{m:Tr settings.tabsize.normal}"
                                     IsChecked="{Binding IsTabsNormal}" />
                        <RadioButton GroupName="tabsize"
                                     Content="{m:Tr settings.tabsize.large}"
                                     IsChecked="{Binding IsTabsLarge}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Classes="section">
                <StackPanel Spacing="10">
                    <TextBlock Classes="heading" Text="{m:Tr settings.language}" />
                    <TextBlock Classes="hint" Text="{m:Tr settings.language.hint}" />
                    <StackPanel Spacing="4" Margin="0,4,0,0">
                        <RadioButton GroupName="language"
                                     Content="{m:Tr settings.language.system}"
                                     IsChecked="{Binding IsLanguageSystem}" />
                        <RadioButton GroupName="language"
                                     Content="English"
                                     IsChecked="{Binding IsLanguageEnglish}" />
                        <RadioButton GroupName="language"
                                     Content="Deutsch"
                                     IsChecked="{Binding IsLanguageGerman}" />
                    </StackPanel>
                    <TextBlock Classes="hint"
                               Text="{Binding FollowingText}"
                               IsVisible="{Binding IsLanguageSystem}" />
                </StackPanel>
            </Border>

            <Border Classes="section">
                <StackPanel Spacing="10">
                    <TextBlock Classes="heading" Text="{m:Tr settings.names}" />
                    <TextBlock Classes="hint" Text="{m:Tr settings.names.hint}" />
                    <ToggleSwitch IsChecked="{Binding FelineNames}"
                                  OnContent="{m:Tr settings.names.feline}"
                                  OffContent="{m:Tr settings.names.plain}"
                                  Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <Border Classes="section">
                <StackPanel Spacing="10">
                    <TextBlock Classes="heading" Text="{m:Tr settings.tray}" />
                    <TextBlock Classes="hint" Text="{m:Tr settings.tray.hint}" />

                    <CheckBox Content="{m:Tr settings.tray.close}"
                              IsChecked="{Binding CloseToTray}"
                              Margin="0,4,0,0" />
                    <TextBlock Classes="hint" Text="{m:Tr settings.tray.close.hint}" />

                    <CheckBox Content="{m:Tr settings.outside}"
                              IsChecked="{Binding SayOutside}"
                              Margin="0,4,0,0" />
                    <TextBlock Classes="hint" Text="{Binding OutsideHow}" />
                </StackPanel>
            </Border>

            <Border Classes="section">
                <StackPanel Spacing="10">
                    <TextBlock Classes="heading" Text="{m:Tr settings.history}" />
                    <TextBlock Classes="hint" Text="{m:Tr settings.history.hint}" />

                    <StackPanel Spacing="4" Margin="0,4,0,0">
                        <RadioButton GroupName="HistoryKeep" Content="{m:Tr settings.history.forever}" IsChecked="{Binding KeepForever}" />
                        <RadioButton GroupName="HistoryKeep" Content="{m:Tr settings.history.year}" IsChecked="{Binding KeepAYear}" />
                        <RadioButton GroupName="HistoryKeep" Content="{m:Tr settings.history.sixmonths}" IsChecked="{Binding KeepSixMonths}" />
                        <RadioButton GroupName="HistoryKeep" Content="{m:Tr settings.history.threemonths}" IsChecked="{Binding KeepThreeMonths}" />
                        <RadioButton GroupName="HistoryKeep" Content="{m:Tr settings.history.month}" IsChecked="{Binding KeepAMonth}" />
                    </StackPanel>
                    <TextBlock Classes="hint" Text="{m:Tr settings.history.note}" />

                    <CheckBox Content="{m:Tr settings.recap}"
                              IsChecked="{Binding WeeklyRecap}"
                              Margin="0,4,0,0" />
                    <TextBlock Classes="hint" Text="{m:Tr settings.recap.hint}" />
                </StackPanel>
            </Border>

            <!-- Where plugins can copy to. A folder is anything Windows can already open; SFTP is
                 a key, kept sealed, and a server key a person has looked at and trusted. -->
            <Border Classes="section" IsVisible="{Binding HasServer}">
                <StackPanel Spacing="10" DataContext="{Binding Server}" x:DataType="vm:ServerViewModel">
                    <TextBlock Classes="heading" Text="{m:Tr settings.server}" />
                    <TextBlock Classes="hint" Text="{m:Tr settings.server.hint}" />
                    <StackPanel Spacing="4" Margin="0,4,0,0">
                        <RadioButton GroupName="reach" Content="{m:Tr settings.server.none}" IsChecked="{Binding IsNone}" />
                        <RadioButton GroupName="reach" Content="{m:Tr settings.server.folder}" IsChecked="{Binding IsFolder}" />
                        <RadioButton GroupName="reach" Content="{m:Tr settings.server.sftp}" IsChecked="{Binding IsSftp}" />
                    </StackPanel>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding IsFolder}">
                        <TextBox Text="{Binding Folder}" PlaceholderText="{m:Tr settings.server.folder.placeholder}" />
                        <Button Grid.Column="1" Content="{m:Tr settings.server.browse}" Command="{Binding BrowseFolderCommand}" />
                    </Grid>

                    <StackPanel Spacing="8" IsVisible="{Binding IsSftp}">
                        <Grid ColumnDefinitions="2*,Auto,*" ColumnSpacing="8">
                            <TextBox Text="{Binding Host}" PlaceholderText="{m:Tr settings.server.host}" />
                            <TextBlock Grid.Column="1" Text=":" VerticalAlignment="Center" Opacity="0.5" />
                            <NumericUpDown Grid.Column="2" Value="{Binding Port}" Minimum="1" Maximum="65535" Increment="1" FormatString="0" />
                        </Grid>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <TextBox Text="{Binding User}" PlaceholderText="{m:Tr settings.server.user}" />
                            <TextBox Grid.Column="1" Text="{Binding RemoteRoot}" PlaceholderText="{m:Tr settings.server.root}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                            <TextBlock Classes="hint" Text="{Binding KeyText}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="{m:Tr settings.server.key.choose}" Command="{Binding ChooseKeyCommand}" />
                            <Button Grid.Column="2" Content="{m:Tr settings.server.key.forget}" Command="{Binding ForgetKeyCommand}" />
                        </Grid>
                        <TextBox Text="{Binding Passphrase}" PasswordChar="•" PlaceholderText="{Binding PassphraseHint}" />
                        <TextBlock Classes="hint" Text="{Binding TrustedKeyText}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding !IsNone}">
                        <Button Content="{m:Tr settings.server.test}" Command="{Binding TestCommand}" />
                        <Button Content="{m:Tr settings.server.trust}" Command="{Binding TrustCommand}" IsVisible="{Binding HasOfferedKey}" />
                    </StackPanel>
                    <TextBlock Classes="hint" Text="{Binding TestResult}" IsVisible="{Binding HasTestResult}" />
                    <TextBlock Classes="hint" Text="{Binding StateText}" />
                </StackPanel>
            </Border>

            <Border Classes="section">
                <StackPanel Spacing="10">
                    <TextBlock Classes="heading" Text="{m:Tr settings.startup}" />
                    <TextBlock Classes="hint" Text="{m:Tr settings.startup.hint}" />

                    <CheckBox Content="{m:Tr settings.startup.enabled}"
                              IsChecked="{Binding StartsWithWindows}"
                              IsEnabled="{Binding CanStartWithWindows}"
                              Margin="0,4,0,0" />

                    <StackPanel Spacing="2" IsVisible="{Binding CanStartWithWindows}">
                        <TextBlock Classes="hint" Text="{m:Tr settings.startup.path}" />
                        <SelectableTextBlock Text="{Binding StartupPath}"
                                             FontFamily="Cascadia Mono,Consolas,monospace"
                                             FontSize="11"
                                             Opacity="0.7"
                                             TextWrapping="Wrap" />
                    </StackPanel>

                    <CheckBox Content="{m:Tr settings.startup.intray}"
                              IsChecked="{Binding StartInTray}"
                              IsEnabled="{Binding CanStartWithWindows}" />
                    <TextBlock Classes="hint" Text="{m:Tr settings.startup.intray.hint}" />

                    <!-- Only shown when there is something to say: pointing at another copy, or
                         switched off in Windows' own list, where a tick here would be a lie. -->
                    <Border Background="{DynamicResource MeowsWarn}"
                            BorderBrush="{DynamicResource MeowsWarnLine}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="8,6"
                            IsVisible="{Binding HasStartupNote}">
                        <TextBlock Text="{Binding StartupNote}"
                                   Foreground="{DynamicResource MeowsWarnText}"
                                   FontSize="11"
                                   TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </Border>

            <Border Classes="section">
                <StackPanel Spacing="10">
                    <TextBlock Classes="heading" Text="{m:Tr settings.storage}" />
                    <TextBlock Classes="hint" Text="{m:Tr settings.storage.hint}" />
                    <TextBlock Classes="hint" Text="{m:Tr settings.storage.portable}" IsVisible="{Binding IsPortable}" />
                    <TextBlock Classes="hint" Text="{m:Tr settings.storage.portable.how}" IsVisible="{Binding !IsPortable}" />
                    <SelectableTextBlock Text="{Binding SettingsFolder}"
                                         FontFamily="Cascadia Mono,Consolas,monospace"
                                         FontSize="12"
                                         Opacity="0.75"
                                         TextWrapping="Wrap" />
                    <Button Content="{m:Tr settings.storage.open}"
                            HorizontalAlignment="Left"
                            Command="{Binding OpenSettingsFolderCommand}" />
                </StackPanel>
            </Border>

            <Border Classes="section">
                <StackPanel Spacing="10">
                    <TextBlock Classes="heading" Text="{m:Tr settings.bundle}" />
                    <TextBlock Classes="hint" Text="{m:Tr settings.bundle.hint}" />
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                        <Button Name="ExportButton" Content="{m:Tr settings.bundle.export}" />
                        <Button Name="ImportButton" Content="{m:Tr settings.bundle.import}" />
                    </StackPanel>
                    <TextBlock Classes="hint" Text="{m:Tr settings.bundle.note}" />
                    <Border Background="{DynamicResource MeowsInfo}"
                            BorderBrush="{DynamicResource MeowsInfoLine}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="8,6"
                            IsVisible="{Binding HasBundleNotice}">
                        <TextBlock Text="{Binding BundleNotice}"
                                   Foreground="{DynamicResource MeowsInfoText}"
                                   TextWrapping="Wrap"
                                   FontSize="12" />
                    </Border>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>

</UserControl>
