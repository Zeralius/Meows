<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Meows.ViewModels"
             xmlns:m="using:Meows.Plugins.Abstractions"
             x:Class="Meows.Views.PluginsView"
             x:DataType="vm:MainWindowViewModel">

    <DockPanel Margin="20">

        <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,18">
            <TextBlock Text="{m:Tr plugins.title}" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Opacity="0.55"
                       TextWrapping="Wrap"
                       Text="{m:Tr plugins.subtitle}" />
            <TextBlock Opacity="0.35" FontSize="11" Text="{Binding ContractVersionText}" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Top"
                    Orientation="Horizontal"
                    Spacing="10"
                    Margin="0,0,0,14">
            <Button Content="{m:Tr plugins.rescan}" Command="{Binding RescanCommand}" />
            <Button Content="{m:Tr plugins.open}" Command="{Binding OpenPluginsFolderCommand}" />
        </StackPanel>

        <TextBlock DockPanel.Dock="Top"
                   Margin="0,0,0,14"
                   Opacity="0.5"
                   TextWrapping="Wrap"
                   IsVisible="{Binding !HasPlugins}"
                   Text="{m:Tr plugins.empty}" />

        <ScrollViewer>
            <ItemsControl ItemsSource="{Binding PluginGroups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PluginGroupViewModel">
                        <StackPanel Margin="0,0,0,10">

                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="2,0,0,8">
                                <TextBlock Text="{Binding Name}"
                                           FontWeight="SemiBold"
                                           FontSize="12"
                                           Opacity="0.55" />
                                <TextBlock Text="{Binding CountText}"
                                           FontSize="11"
                                           Opacity="0.3"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <ItemsControl ItemsSource="{Binding Entries}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PluginEntryViewModel">
                        <Border Background="{DynamicResource MeowsCard}"
                                BorderBrush="{DynamicResource MeowsLine}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16,13"
                                Margin="0,0,0,10">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Icon}"
                                           FontSize="22"
                                           VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Spacing="3">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="15" />
                                    <TextBlock Text="{Binding Description}" Opacity="0.6" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Origin}" Opacity="0.35" FontSize="11" />
                                    <TextBlock Text="{Binding Error}"
                                               Foreground="{DynamicResource MeowsDangerStrong}"
                                               TextWrapping="Wrap"
                                               IsVisible="{Binding HasError}" />
                                    <TextBlock Text="{Binding IncompatibleReason}"
                                               Foreground="{DynamicResource MeowsWarnText}"
                                               TextWrapping="Wrap"
                                               IsVisible="{Binding IsIncompatible}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center">
                                    <ToggleSwitch IsChecked="{Binding IsActivated}"
                                                  IsEnabled="{Binding IsCompatible}"
                                                  OnContent="{m:Tr plugins.active}"
                                                  OffContent="{m:Tr plugins.inactive}"
                                                  IsVisible="{Binding IsCompatible}" />
                                    <Border Background="{DynamicResource MeowsWarn}"
                                            BorderBrush="{DynamicResource MeowsWarnLine}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="8,3"
                                            IsVisible="{Binding IsIncompatible}">
                                        <TextBlock Text="{m:Tr plugins.incompatible}" Foreground="{DynamicResource MeowsWarnText}" FontSize="11" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </DockPanel>

</UserControl>
