<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Meows.ViewModels"
             xmlns:svc="using:Meows.Services"
             xmlns:m="using:Meows.Plugins.Abstractions"
             x:Class="Meows.Views.LogView"
             x:DataType="vm:LogViewModel">

    <UserControl.Styles>
        <Style Selector="TextBlock.label">
            <Setter Property="Opacity" Value="0.5" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style Selector="TextBlock.line">
            <Setter Property="FontFamily" Value="Cascadia Mono,Consolas,monospace" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Opacity" Value="0.8" />
        </Style>
        <Style Selector="TextBlock.line.warning">
            <Setter Property="Foreground" Value="{DynamicResource MeowsWarnText}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="TextBlock.line.error">
            <Setter Property="Foreground" Value="{DynamicResource MeowsDangerText}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
    </UserControl.Styles>

    <DockPanel>

        <Border DockPanel.Dock="Top"
                Background="{DynamicResource MeowsCard}"
                BorderBrush="{DynamicResource MeowsLineSoft}"
                BorderThickness="0,0,0,1"
                Padding="14,10">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="{m:Tr log.title}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding SummaryText}" Classes="label" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <TextBox Text="{Binding Filter}"
                             Watermark="{m:Tr log.filter}"
                             Width="220"
                             FontSize="11" />
                    <ComboBox ItemsSource="{Binding SourceChoices}"
                              SelectedItem="{Binding SelectedSourceChoice}"
                              MinWidth="140"
                              FontSize="11"
                              VerticalAlignment="Center" />
                    <ToggleButton Content="{m:Tr log.trouble}"
                                  IsChecked="{Binding OnlyTrouble}"
                                  FontSize="11"
                                  VerticalAlignment="Center" />
                    <Button Content="{m:Tr log.clearfilter}" Command="{Binding ClearFilterCommand}" FontSize="11" />
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource MeowsBar}"
                BorderBrush="{DynamicResource MeowsLineSoft}"
                BorderThickness="0,1,0,0"
                Padding="14,6">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                <TextBlock Grid.Column="0" Classes="label" Text="{Binding ShownText}" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="{m:Tr log.openfile}" Command="{Binding OpenFileCommand}" FontSize="11" />
            </Grid>
        </Border>

        <Grid ColumnDefinitions="*,4,260">

            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top"
                           Margin="14,14,14,10"
                           Opacity="0.45"
                           TextWrapping="Wrap"
                           IsVisible="{Binding IsEmpty}"
                           Text="{m:Tr log.empty}" />
                <ScrollViewer Padding="10,6">
                    <ItemsControl ItemsSource="{Binding Visible}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="svc:LogEntry">
                                <TextBlock Text="{Binding Text}"
                                           Classes="line"
                                           Classes.warning="{Binding IsWarning}"
                                           Classes.error="{Binding IsError}"
                                           TextWrapping="NoWrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>

            <GridSplitter Grid.Column="1" Background="{DynamicResource MeowsRaised}" ResizeDirection="Columns" />

            <!-- Per source: how much of it to show. Everything, only trouble, or nothing, which
                 is the quiet mode for a plugin with a lot to say. The file keeps it all. -->
            <Border Grid.Column="2"
                    Background="{DynamicResource MeowsBase}"
                    BorderBrush="{DynamicResource MeowsLineSoft}"
                    BorderThickness="1,0,0,0">
                <ScrollViewer Padding="14,12">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{m:Tr log.sources}" FontWeight="SemiBold" FontSize="13" />
                        <TextBlock Text="{m:Tr log.sources.hint}" Classes="label" TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding Sources}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:LogSourceViewModel">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,4,0,0">
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <ComboBox Grid.Column="1"
                                                  ItemsSource="{Binding Choices}"
                                                  SelectedItem="{Binding Selected}"
                                                  FontSize="11"
                                                  MinWidth="130" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>

        </Grid>

    </DockPanel>

</UserControl>
