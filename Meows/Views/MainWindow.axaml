<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Meows.ViewModels"
        xmlns:svc="using:Meows.Services"
        xmlns:m="using:Meows.Plugins.Abstractions"
        x:Class="Meows.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Meows"
        Width="1400" Height="880"
        MinWidth="900" MinHeight="560">

    <Window.Styles>
        <!-- The severity of a notification, as a colour. Set from two flags on the item rather
             than a brush it hands us, so the theme gets to decide the actual colour. -->
        <Style Selector="TextBlock.severity">
            <Setter Property="Foreground" Value="{DynamicResource MeowsInfoText}" />
        </Style>
        <Style Selector="TextBlock.severity.warning">
            <Setter Property="Foreground" Value="{DynamicResource MeowsWarnText}" />
        </Style>
        <Style Selector="TextBlock.severity.error">
            <Setter Property="Foreground" Value="{DynamicResource MeowsDangerStrong}" />
        </Style>
    </Window.Styles>

    <DockPanel>

        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource MeowsBar}"
                BorderBrush="{DynamicResource MeowsLine}"
                BorderThickness="0,1,0,0"
                Padding="10,4">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock Grid.Column="0"
                           Text="{Binding AppVersionText}"
                           FontWeight="SemiBold"
                           Opacity="0.55"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Margin="12,0"
                           Opacity="0.45"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Text="{Binding PluginsDirectoryText}" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                    <ToggleButton Content="{Binding TaskBadge}"
                                  Padding="10,2"
                                  IsChecked="{Binding IsTasksOpen}" />
                    <ToggleButton Content="{Binding NotificationBadge}"
                                  Padding="10,2"
                                  IsChecked="{Binding IsNotificationsOpen}" />
                    <ToggleButton Content="{m:Tr shell.log}"
                                  Padding="10,2"
                                  IsChecked="{Binding IsLogVisible}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom"
                MaxHeight="300"
                Background="{DynamicResource MeowsPanel}"
                BorderBrush="{DynamicResource MeowsLine}"
                BorderThickness="0,1,0,0"
                IsVisible="{Binding IsNotificationsOpen}">
            <DockPanel>
                <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="12,8,12,4">
                    <TextBlock Grid.Column="0" Text="{m:Tr shell.notifications}" FontWeight="SemiBold" Opacity="0.6" />
                    <Button Grid.Column="1"
                            Content="{m:Tr shell.notifications.clear}"
                            FontSize="11"
                            Padding="8,2"
                            Command="{Binding ClearNotificationsCommand}" />
                </Grid>
                <TextBlock DockPanel.Dock="Top"
                           Margin="12,4,12,10"
                           Opacity="0.4"
                           FontSize="11"
                           IsVisible="{Binding !HasNotifications}"
                           Text="{m:Tr shell.notifications.empty}" />
                <ScrollViewer Padding="12,0,12,10">
                    <ItemsControl ItemsSource="{Binding Notifications}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="svc:NotificationItem">
                                <Border Background="{DynamicResource MeowsCard}"
                                        BorderBrush="{DynamicResource MeowsLine}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="10,8"
                                        Margin="0,0,0,6">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Glyph}"
                                                   Classes="severity"
                                                   Classes.warning="{Binding IsWarning}"
                                                   Classes.error="{Binding IsError}"
                                                   VerticalAlignment="Top" />
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Message}"
                                                       Opacity="0.7"
                                                       FontSize="11"
                                                       TextWrapping="Wrap"
                                                       IsVisible="{Binding HasMessage}" />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding Source}" Opacity="0.4" FontSize="10" />
                                                <TextBlock Text="{Binding TimeText}" Opacity="0.4" FontSize="10" />
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                                            <Button Content="{Binding ActionLabel}"
                                                    FontSize="11"
                                                    Padding="8,2"
                                                    IsVisible="{Binding HasAction}"
                                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).InvokeNotificationActionCommand}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="✕"
                                                    FontSize="11"
                                                    Padding="7,2"
                                                    IsVisible="{Binding CanDismiss}"
                                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).DismissNotificationCommand}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Bottom"
                MaxHeight="220"
                Background="{DynamicResource MeowsPanel}"
                BorderBrush="{DynamicResource MeowsLine}"
                BorderThickness="0,1,0,0"
                IsVisible="{Binding IsTasksOpen}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Text="{m:Tr shell.tasks.title}"
                           FontWeight="SemiBold"
                           Opacity="0.6"
                           Margin="12,8,12,4" />
                <TextBlock DockPanel.Dock="Top"
                           Margin="12,4,12,10"
                           Opacity="0.4"
                           FontSize="11"
                           IsVisible="{Binding !HasRunningTasks}"
                           Text="{m:Tr shell.tasks.empty}" />
                <ScrollViewer Padding="12,0,12,10">
                    <ItemsControl ItemsSource="{Binding RunningTasks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="svc:BackgroundTaskItem">
                                <Border Background="{DynamicResource MeowsCard}"
                                        BorderBrush="{DynamicResource MeowsLine}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="10,8"
                                        Margin="0,0,0,6">
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Status}" Opacity="0.65" FontSize="11" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Source}" Opacity="0.4" FontSize="10" />
                                        </StackPanel>
                                        <ProgressBar Grid.Column="1"
                                                     Width="140"
                                                     VerticalAlignment="Center"
                                                     Minimum="0" Maximum="100"
                                                     Value="{Binding ProgressPercent}"
                                                     IsIndeterminate="{Binding !HasProgress}" />
                                        <Button Grid.Column="2"
                                                Content="{m:Tr shell.cancel}"
                                                FontSize="11"
                                                Padding="8,2"
                                                VerticalAlignment="Center"
                                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CancelTaskCommand}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Bottom"
                Height="190"
                Background="{DynamicResource MeowsPanel}"
                BorderBrush="{DynamicResource MeowsLine}"
                BorderThickness="0,1,0,0"
                IsVisible="{Binding IsLogVisible}">
            <ScrollViewer Padding="10,6">
                <ItemsControl ItemsSource="{Binding LogLines}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{Binding}"
                                       FontFamily="Cascadia Mono,Consolas,monospace"
                                       FontSize="11"
                                       Opacity="0.75"
                                       TextWrapping="NoWrap" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <TabControl ItemsSource="{Binding Tabs}"
                    SelectedItem="{Binding SelectedTab}"
                    Padding="0">
            <TabControl.ItemTemplate>
                <DataTemplate x:DataType="vm:TabViewModel">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <!-- Named rather than left to fallback. Windows has two fonts holding
                             these characters, Segoe UI Symbol in monochrome outlines and Segoe UI
                             Emoji in colour, and left to itself the first layout picks the outline
                             for some of them. Hovering a tab lays it out again, it comes back in
                             colour and stays that way, so the icons changed under the pointer. -->
                        <TextBlock Text="{Binding Icon}"
                                   FontFamily="Segoe UI Emoji"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Header}" VerticalAlignment="Center" />
                    </StackPanel>
                </DataTemplate>
            </TabControl.ItemTemplate>
            <TabControl.ContentTemplate>
                <DataTemplate x:DataType="vm:TabViewModel">
                    <ContentControl Content="{Binding Content}" />
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>

    </DockPanel>

</Window>
