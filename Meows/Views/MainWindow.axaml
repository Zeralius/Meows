<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Meows.ViewModels"
        xmlns:svc="using:Meows.Services"
        xmlns:m="using:Meows.Plugins.Abstractions"
        x:Class="Meows.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Meows"
        Icon="/Assets/meows.ico"
        Width="1400" Height="880"
        MinWidth="900" MinHeight="560">

    <Window.Styles>
        <!-- The strip's own two buttons. Flat, so the strip reads as a strip rather than as a
             row of controls, with the selected tab raised and underlined. -->
        <Style Selector="Button.tab, Button.chip">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
        <Style Selector="Button.tab:pointerover /template/ ContentPresenter, Button.chip:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource MeowsRaised}" />
        </Style>
        <!-- The tab in front: the selection colour and a line in the text colour along its
             bottom. Base on Bar, which is what it was, is 1.04:1, so only the weight told it apart;
             the line is its own, separate from the group's coloured underline. -->
        <Style Selector="Button.tab /template/ ContentPresenter">
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Button.tab.selected /template/ ContentPresenter, Button.tab.selected:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource MeowsSelection}" />
            <Setter Property="BorderBrush" Value="{DynamicResource MeowsForeground}" />
        </Style>
        <Style Selector="Button.tab.selected">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.chip">
            <Setter Property="Padding" Value="8,5" />
        </Style>
        <!-- How big the strip is drawn. The size is a class on the ItemsControl rather than a
             number bound into every element, so one setting moves the tabs, the chips, the icons
             and the emoji together: everything inside a tab inherits the button's font size. -->
        <Style Selector="ItemsControl.strip Button.tab, ItemsControl.strip Button.chip">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="10,5" />
        </Style>
        <Style Selector="ItemsControl.strip.compact Button.tab, ItemsControl.strip.compact Button.chip">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="7,3" />
        </Style>
        <Style Selector="ItemsControl.strip.large Button.tab, ItemsControl.strip.large Button.chip">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Padding" Value="14,9" />
        </Style>
        <!-- The pop-out corner and the underline keep their proportion to the rest. -->
        <Style Selector="ItemsControl.strip.large Button.tab Button">
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="ItemsControl.strip.large Border.groupline">
            <Setter Property="Height" Value="3" />
        </Style>
        <Style Selector="ItemsControl.strip.compact Button.tab Button">
            <Setter Property="FontSize" Value="10" />
        </Style>

        <!-- The insertion marker while something is dragged over the strip. -->
        <Style Selector="Border.marker">
            <Setter Property="Width" Value="2" />
            <Setter Property="MinHeight" Value="16" />
            <Setter Property="CornerRadius" Value="1" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Background" Value="{DynamicResource MeowsSelectionLine}" />
        </Style>
        <!-- The severity of a notification, as a colour. Set from two flags on the item rather
             than a brush it hands us, so the theme gets to decide the actual colour. -->
        <Style Selector="TextBlock.severity">
            <Setter Property="Foreground" Value="{DynamicResource MeowsInfoText}" />
        </Style>
        <Style Selector="TextBlock.severity.warning">
            <Setter Property="Foreground" Value="{DynamicResource MeowsWarnText}" />
        </Style>
        <Style Selector="TextBlock.severity.error">
            <Setter Property="Foreground" Value="{DynamicResource MeowsDangerStrong}" />
        </Style>
    </Window.Styles>

    <!-- The whole window, drawn at the text size picked on the Settings tab or Windows' own. -->
    <LayoutTransformControl Name="Zoom">
    <Panel>

    <DockPanel>

        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource MeowsBar}"
                BorderBrush="{DynamicResource MeowsLine}"
                BorderThickness="0,1,0,0"
                Padding="10,4">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- Where the plugins are read from, on the version's tooltip: it is worth knowing
                     when something is not loading, and noise in the bar the rest of the time. -->
                <TextBlock Grid.Column="0"
                           Text="{Binding AppVersionText}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource MeowsTextMuted}"
                           ToolTip.Tip="{Binding PluginsDirectoryText}"
                           VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0" Spacing="12">
                    <!-- A newer Meows on the releases page. A link, not a download: the running exe
                         is not something the shell replaces underneath itself. -->
                    <Button Content="{Binding ShellUpdateText}"
                            Command="{Binding OpenShellUpdateCommand}"
                            IsVisible="{Binding HasShellUpdate}"
                            Padding="8,1"
                            FontSize="12"
                            Classes="info"
                            VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                    <Button Content="{m:Tr shell.palette}"
                            Padding="10,2"
                            Command="{Binding OpenPaletteCommand}"
                            ToolTip.Tip="{m:Tr shell.palette.tip}" />
                    <!-- Feline names or plain ones. The same switch is on the Settings tab. -->
                    <ToggleButton Content="🐾"
                                  FontFamily="Segoe UI Emoji"
                                  Padding="10,2"
                                  IsChecked="{Binding FelineNames}"
                                  ToolTip.Tip="{m:Tr shell.names.tip}"
                                  AutomationProperties.Name="{m:Tr shell.names.tip}" />
                    <!-- Personas: named sets of switched-on plugins, one pick to switch. -->
                    <ComboBox ItemsSource="{Binding PersonaNames}"
                              SelectedItem="{Binding SelectedPersonaName}"
                              PlaceholderText="{m:Tr shell.persona.hint}"
                              AutomationProperties.Name="{m:Tr shell.persona.hint}"
                              MinWidth="110"
                              VerticalAlignment="Center" />
                    <ToggleButton Content="{Binding TaskBadge}"
                                  Padding="10,2"
                                  IsChecked="{Binding IsTasksOpen}" />
                    <ToggleButton Content="{Binding NotificationBadge}"
                                  AutomationProperties.Name="{Binding NotificationBadgeName}"
                                  Padding="10,2"
                                  IsChecked="{Binding IsNotificationsOpen}" />
                    <ToggleButton Content="{m:Tr shell.log}"
                                  Padding="10,2"
                                  IsChecked="{Binding IsLogVisible}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom"
                MaxHeight="300"
                Background="{DynamicResource MeowsPanel}"
                BorderBrush="{DynamicResource MeowsLine}"
                BorderThickness="0,1,0,0"
                IsVisible="{Binding IsNotificationsOpen}">
            <DockPanel>
                <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="12,8,12,4">
                    <TextBlock Grid.Column="0" Text="{m:Tr shell.notifications}" FontWeight="SemiBold" Foreground="{DynamicResource MeowsTextMuted}" />
                    <Button Grid.Column="1"
                            Content="{m:Tr shell.notifications.clear}"
                            FontSize="11"
                            Padding="8,2"
                            Command="{Binding ClearNotificationsCommand}" />
                </Grid>
                <TextBlock DockPanel.Dock="Top"
                           Margin="12,4,12,10"
                           Foreground="{DynamicResource MeowsTextMuted}"
                           FontSize="11"
                           IsVisible="{Binding !HasNotifications}"
                           Text="{m:Tr shell.notifications.empty}" />
                <ScrollViewer Padding="12,0,12,10">
                    <ItemsControl ItemsSource="{Binding Notifications}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="svc:NotificationItem">
                                <Border Background="{DynamicResource MeowsCard}"
                                        BorderBrush="{DynamicResource MeowsLine}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="10,8"
                                        Margin="0,0,0,6">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Glyph}"
                                                   Classes="severity"
                                                   Classes.warning="{Binding IsWarning}"
                                                   Classes.error="{Binding IsError}"
                                                   VerticalAlignment="Top" />
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Message}"
                                                       Opacity="0.7"
                                                       FontSize="11"
                                                       TextWrapping="Wrap"
                                                       IsVisible="{Binding HasMessage}" />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding SourceName}" Foreground="{DynamicResource MeowsTextMuted}" FontSize="10" />
                                                <TextBlock Text="{Binding TimeText}" Foreground="{DynamicResource MeowsTextMuted}" FontSize="10" />
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                                            <!-- As many buttons as the plugin gave it, each its own verb. -->
                                            <ItemsControl ItemsSource="{Binding Buttons}" IsVisible="{Binding HasAction}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" Spacing="6" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="svc:NotificationButton">
                                                        <Button Content="{Binding Label}"
                                                                FontSize="11"
                                                                Padding="8,2"
                                                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).InvokeNotificationActionCommand}"
                                                                CommandParameter="{Binding}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Button Content="✕"
                                                    AutomationProperties.Name="{m:Tr shell.dismiss}"
                                                    ToolTip.Tip="{m:Tr shell.dismiss}"
                                                    FontSize="11"
                                                    Padding="7,2"
                                                    IsVisible="{Binding CanDismiss}"
                                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).DismissNotificationCommand}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Bottom"
                MaxHeight="220"
                Background="{DynamicResource MeowsPanel}"
                BorderBrush="{DynamicResource MeowsLine}"
                BorderThickness="0,1,0,0"
                IsVisible="{Binding IsTasksOpen}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Text="{m:Tr shell.tasks.title}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource MeowsTextMuted}"
                           Margin="12,8,12,4" />
                <TextBlock DockPanel.Dock="Top"
                           Margin="12,4,12,10"
                           Foreground="{DynamicResource MeowsTextMuted}"
                           FontSize="11"
                           IsVisible="{Binding !HasRunningTasks}"
                           Text="{m:Tr shell.tasks.empty}" />
                <ScrollViewer Padding="12,0,12,10">
                    <ItemsControl ItemsSource="{Binding RunningTasks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="svc:BackgroundTaskItem">
                                <Border Background="{DynamicResource MeowsCard}"
                                        BorderBrush="{DynamicResource MeowsLine}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="10,8"
                                        Margin="0,0,0,6">
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Status}" Opacity="0.65" FontSize="11" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding SourceName}" Foreground="{DynamicResource MeowsTextMuted}" FontSize="10" />
                                        </StackPanel>
                                        <ProgressBar Grid.Column="1"
                                                     Width="140"
                                                     VerticalAlignment="Center"
                                                     Minimum="0" Maximum="100"
                                                     Value="{Binding ProgressPercent}"
                                                     IsIndeterminate="{Binding !HasProgress}" />
                                        <Button Grid.Column="2"
                                                Content="{m:Tr shell.cancel}"
                                                FontSize="11"
                                                Padding="8,2"
                                                VerticalAlignment="Center"
                                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CancelTaskCommand}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Bottom"
                Height="190"
                Background="{DynamicResource MeowsPanel}"
                BorderBrush="{DynamicResource MeowsLine}"
                BorderThickness="0,1,0,0"
                IsVisible="{Binding IsLogVisible}">
            <ScrollViewer Padding="10,6">
                <ItemsControl ItemsSource="{Binding LogLines}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="svc:LogEntry">
                            <TextBlock Text="{Binding Text}"
                                       FontFamily="Cascadia Mono,Consolas,monospace"
                                       FontSize="11"
                                       Opacity="0.75"
                                       TextWrapping="NoWrap" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- The strip, and under it whatever tab is selected.
             It was a TabControl over one flat list until 4.0.0, when twenty-three tabs wrapped
             onto three rows. A TabControl cannot interleave a group's chip with its own tabs, so
             the strip is built here and the content is an ordinary ContentControl; selection was
             already driven by SelectedTab and the number keys were already ours, so nothing was
             lost along with the control. -->
        <DockPanel>

            <Border DockPanel.Dock="Top"
                    Background="{DynamicResource MeowsBar}"
                    BorderBrush="{DynamicResource MeowsLine}"
                    BorderThickness="0,0,0,1"
                    Padding="6,4">
                <ItemsControl Name="Strip"
                              Classes="strip"
                              Classes.compact="{Binding Strip.IsCompact}"
                              Classes.large="{Binding Strip.IsLarge}"
                              ItemsSource="{Binding Strip.Items}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.DataTemplates>

                        <!-- A group: a coloured chip that opens and shuts it, with everything
                             that can be done to the group on its right-click menu. -->
                        <DataTemplate x:DataType="vm:GroupChipViewModel">
                            <Button Classes="chip"
                                    Command="{Binding ToggleCommand}"
                                    ToolTip.Tip="{Binding Name}"
                                    AutomationProperties.Name="{Binding AccessibleName}">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <!-- Where a drop would land. A line either side rather than a
                                         highlight on the whole thing, because "into this group"
                                         and "in front of this group" are different answers. -->
                                    <Border Classes="marker" IsVisible="{Binding HintBefore}" />
                                    <Border Width="8"
                                            Height="8"
                                            CornerRadius="4"
                                            VerticalAlignment="Center"
                                            Background="{Binding Paint}" />
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontWeight="SemiBold" />
                                    <Border Background="{DynamicResource MeowsInset}"
                                            CornerRadius="7"
                                            Padding="5,0"
                                            VerticalAlignment="Center"
                                            IsVisible="{Binding IsCollapsed}">
                                        <TextBlock Text="{Binding CountText}" FontSize="11" Opacity="0.8" />
                                    </Border>
                                    <TextBlock Text="{Binding Arrow}" VerticalAlignment="Center" Foreground="{DynamicResource MeowsTextMuted}" FontSize="10" />
                                    <Border Classes="marker" IsVisible="{Binding HintAfter}" />
                                </StackPanel>
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{Binding CollapseText}" Command="{Binding ToggleCommand}" />
                                        <Separator />
                                        <MenuItem Header="{m:Tr strip.rename}" Command="{Binding AskRenameCommand}" />
                                        <MenuItem Header="{m:Tr strip.colour}" ItemsSource="{Binding Colours}">
                                            <MenuItem.ItemContainerTheme>
                                                <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}" x:DataType="vm:GroupColourChoice">
                                                    <Setter Property="Header" Value="{Binding Name}" />
                                                    <Setter Property="Command" Value="{Binding PickCommand}" />
                                                </ControlTheme>
                                            </MenuItem.ItemContainerTheme>
                                        </MenuItem>
                                        <Separator />
                                        <MenuItem Header="{m:Tr strip.group.left}" Command="{Binding MoveLeftCommand}" />
                                        <MenuItem Header="{m:Tr strip.group.right}" Command="{Binding MoveRightCommand}" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </DataTemplate>

                        <!-- A tab: the icon, the name, the pop-out, and its group's colour as a
                             line underneath, so the eye can follow a group across a wrap. -->
                        <DataTemplate x:DataType="vm:TabViewModel">
                            <Button Classes="tab"
                                    Classes.selected="{Binding IsSelected}"
                                    AutomationProperties.Name="{Binding AccessibleName}"
                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SelectTabCommand}"
                                    CommandParameter="{Binding}">
                                <StackPanel Spacing="3">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <Border Classes="marker" IsVisible="{Binding HintBefore}" />
                                        <!-- Named rather than left to fallback. Windows has two fonts holding
                                             these characters, Segoe UI Symbol in monochrome outlines and Segoe UI
                                             Emoji in colour, and left to itself the first layout picks the outline
                                             for some of them. Hovering a tab lays it out again, it comes back in
                                             colour and stays that way, so the icons changed under the pointer. -->
                                        <TextBlock Text="{Binding Icon}"
                                                   FontFamily="Segoe UI Emoji"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Header}" VerticalAlignment="Center" />
                                        <!-- Into a window of its own. Quieter than the name so the strip stays a
                                             strip. Not a stop for Tab: the same thing is on the tab's menu, and a
                                             stop inside every tab would double the keypresses along the strip. -->
                                        <Button Content="⧉"
                                                FontSize="11"
                                                Padding="3,0"
                                                MinHeight="0"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Classes="quiet"
                                                IsTabStop="False"
                                                VerticalAlignment="Center"
                                                ToolTip.Tip="{Binding PopOutName}"
                                                AutomationProperties.Name="{Binding PopOutName}"
                                                IsVisible="{Binding !IsPoppedOut}"
                                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).PopOutCommand}"
                                                CommandParameter="{Binding}" />
                                        <Border Classes="marker" IsVisible="{Binding HintAfter}" />
                                    </StackPanel>
                                    <Border Classes="groupline"
                                            Height="2"
                                            CornerRadius="1"
                                            IsVisible="{Binding HasGroup}"
                                            Background="{Binding Paint}" />
                                </StackPanel>
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{m:Tr strip.tab.left}" Command="{Binding Menu.MoveLeftCommand}" />
                                        <MenuItem Header="{m:Tr strip.tab.right}" Command="{Binding Menu.MoveRightCommand}" />
                                        <Separator />
                                        <MenuItem Header="{m:Tr strip.tab.moveto}"
                                                  ItemsSource="{Binding Menu.Groups}"
                                                  IsEnabled="{Binding Menu.HasGroups}">
                                            <MenuItem.ItemContainerTheme>
                                                <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}" x:DataType="vm:GroupChoice">
                                                    <Setter Property="Header" Value="{Binding Name}" />
                                                    <Setter Property="Command" Value="{Binding PickCommand}" />
                                                </ControlTheme>
                                            </MenuItem.ItemContainerTheme>
                                        </MenuItem>
                                        <MenuItem Header="{m:Tr strip.tab.newgroup}" Command="{Binding Menu.AskNewGroupCommand}" />
                                        <Separator />
                                        <MenuItem Header="{m:Tr strip.tab.reset}" Command="{Binding Menu.ResetCommand}" />
                                        <MenuItem Header="{m:Tr shell.popout}"
                                                  Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).PopOutCommand}"
                                                  CommandParameter="{Binding}"
                                                  IsVisible="{Binding !IsPoppedOut}" />
                                        <MenuItem Header="{m:Tr strip.tab.off}"
                                                  Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SwitchOffCommand}"
                                                  CommandParameter="{Binding}"
                                                  IsVisible="{Binding IsPlugin}" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </DataTemplate>

                    </ItemsControl.DataTemplates>
                </ItemsControl>
            </Border>

            <!-- The plugin in front is working: a thin moving line under the strip, the same in
                 every plugin, rather than each saying it its own way or not at all. -->
            <ProgressBar DockPanel.Dock="Top"
                         IsIndeterminate="True"
                         Height="3"
                         MinHeight="3"
                         CornerRadius="0"
                         IsVisible="{Binding SelectedTab.IsBusy, FallbackValue=False}"
                         AutomationProperties.Name="{m:Tr shell.busy}" />
            <ContentControl Content="{Binding SelectedTab.Shown}">
                <ContentControl.DataTemplates>
                    <!-- What stands in for a tab while its content is in its own window. -->
                    <DataTemplate x:DataType="vm:PoppedOutNotice">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
                            <TextBlock Text="{m:Tr shell.popout.away}" Foreground="{DynamicResource MeowsTextMuted}" HorizontalAlignment="Center" />
                            <Button Content="{m:Tr shell.popout.back}"
                                    HorizontalAlignment="Center"
                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).BringBackCommand}"
                                    CommandParameter="{Binding Tab}" />
                        </StackPanel>
                    </DataTemplate>
                </ContentControl.DataTemplates>
            </ContentControl>

        </DockPanel>

    </DockPanel>

    <!-- The command palette, over everything, Ctrl+K. A veil that closes it on a click, and a
         card near the top with the box and whatever matches. -->
    <Panel IsVisible="{Binding Palette.IsOpen}">
        <Border Background="{DynamicResource MeowsVeil}" PointerPressed="OnPaletteVeilPressed" />
        <Border Name="PaletteCard"
                KeyboardNavigation.TabNavigation="Cycle"
                Width="620"
                MaxHeight="520"
                VerticalAlignment="Top"
                HorizontalAlignment="Center"
                Margin="0,70,0,0"
                Background="{DynamicResource MeowsCard}"
                BorderBrush="{DynamicResource MeowsLine}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="10">
            <DockPanel>
                <TextBox Name="PaletteBox"
                         DockPanel.Dock="Top"
                         AutomationProperties.Name="{Binding Palette.Hint}"
                         Text="{Binding Palette.Query}"
                         PlaceholderText="{Binding Palette.Hint}"
                         FontSize="15"
                         Margin="0,0,0,8" />
                <TextBlock DockPanel.Dock="Top"
                           Classes="label muted"
                           Margin="6,0,6,8"
                           IsVisible="{Binding Palette.IsEmpty}"
                           Text="{m:Tr palette.nothing}" />
                <ListBox ItemsSource="{Binding Palette.Items}"
                         SelectedItem="{Binding Palette.Selected}"
                         Background="Transparent"
                         BorderThickness="0"
                         DoubleTapped="OnPaletteRun">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem" x:DataType="vm:PaletteItem">
                            <Setter Property="Padding" Value="10,6" />
                            <Setter Property="CornerRadius" Value="6" />
                            <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                        </Style>

                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:PaletteItem">
                            <Grid ColumnDefinitions="28,*" ColumnSpacing="10">
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Glyph}"
                                           FontFamily="Segoe UI Emoji"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Spacing="1">
                                    <TextBlock Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Subtitle}"
                                               Foreground="{DynamicResource MeowsTextMuted}"
                                               FontSize="11"
                                               TextTrimming="CharacterEllipsis"
                                               IsVisible="{Binding HasSubtitle}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
    </Panel>

    <!-- A name asked for: a group renamed, a new group. Over everything, like the palette, and
         the keyboard stays inside it until it is answered. -->
    <Panel IsVisible="{Binding Strip.Prompt.IsOpen}">
        <Border Background="{DynamicResource MeowsVeil}" />
        <Border Name="PromptCard"
                KeyboardNavigation.TabNavigation="Cycle"
                Width="420"
                VerticalAlignment="Top"
                HorizontalAlignment="Center"
                Margin="0,110,0,0"
                Background="{DynamicResource MeowsCard}"
                BorderBrush="{DynamicResource MeowsLine}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="16">
            <StackPanel Spacing="12">
                <TextBlock Name="PromptTitle" Text="{Binding Strip.Prompt.Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBox Name="PromptBox"
                         Text="{Binding Strip.Prompt.Text}"
                         AutomationProperties.LabeledBy="{Binding #PromptTitle}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <Button Content="{m:Tr shell.cancel}" Command="{Binding Strip.Prompt.CancelCommand}" />
                    <Button Content="{m:Tr strip.prompt.ok}" Command="{Binding Strip.Prompt.OkCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Panel>

    </Panel>
    </LayoutTransformControl>

</Window>
