<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Meows.Plugins.Naptime.ViewModels"
             xmlns:m="using:Meows.Plugins.Abstractions"
             x:Class="Meows.Plugins.Naptime.Views.NaptimeView"
             x:DataType="vm:NaptimeViewModel">

    <UserControl.Styles>
        <Style Selector="TextBlock.label">
            <Setter Property="Opacity" Value="0.5" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style Selector="TextBlock.section">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Opacity" Value="0.5" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="CornerRadius" Value="5" />
        </Style>
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource MeowsSelection}" />
        </Style>
    </UserControl.Styles>

    <DockPanel>

        <Border DockPanel.Dock="Top"
                Background="{DynamicResource MeowsCard}"
                BorderBrush="{DynamicResource MeowsLineSoft}"
                BorderThickness="0,0,0,1"
                Padding="14,10">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Classes="label" Text="{Binding Status}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <TextBox Text="{Binding NewHabitName}"
                             PlaceholderText="{m:Tr naptime.field.add.hint}"
                             Width="180"
                             VerticalAlignment="Center" />
                    <Button Content="{m:Tr naptime.add}" Command="{Binding AddCommand}" />
                    <Button Content="{m:Tr naptime.refresh}" Command="{Binding RefreshCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock DockPanel.Dock="Top"
                   Margin="14,14,14,10"
                   Opacity="0.45"
                   TextWrapping="Wrap"
                   IsVisible="{Binding IsEmpty}"
                   Text="{m:Tr naptime.empty}" />

        <ListBox Name="HabitList"
                 ItemsSource="{Binding Habits}"
                 SelectedItem="{Binding Selected}"
                 Background="Transparent"
                 BorderThickness="0"
                 Margin="8">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:HabitRowViewModel">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                        <CheckBox Grid.Column="0"
                                  IsChecked="{Binding DoneToday}"
                                  VerticalAlignment="Center" />

                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBox Text="{Binding Name}"
                                     PlaceholderText="{m:Tr naptime.field.name.hint}"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Padding="0" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding WeekText}" Classes="label" />
                                <TextBlock Text="{Binding StreakText}"
                                           Classes="label"
                                           IsVisible="{Binding HasStreak}" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    Spacing="4"
                                    VerticalAlignment="Center">
                            <Button Content="−"
                                    Command="{Binding TargetDownCommand}"
                                    FontSize="11"
                                    Padding="8,2" />
                            <TextBlock Text="{Binding TargetText}"
                                       Classes="label"
                                       VerticalAlignment="Center" />
                            <Button Content="+"
                                    Command="{Binding TargetUpCommand}"
                                    FontSize="11"
                                    Padding="8,2" />
                        </StackPanel>

                        <Button Grid.Column="3"
                                Content="{m:Tr naptime.delete}"
                                Command="{Binding DeleteCommand}"
                                Background="{DynamicResource MeowsDanger}"
                                BorderBrush="{DynamicResource MeowsDangerLine}"
                                FontSize="11"
                                VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

    </DockPanel>

</UserControl>
