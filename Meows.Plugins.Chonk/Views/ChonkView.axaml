<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Meows.Plugins.Chonk.ViewModels"
             xmlns:m="using:Meows.Plugins.Abstractions"
             x:Class="Meows.Plugins.Chonk.Views.ChonkView"
             x:DataType="vm:ChonkViewModel">

    <UserControl.Styles>
        <Style Selector="TextBlock.label">
            <Setter Property="Opacity" Value="0.5" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style Selector="TextBlock.section">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Opacity" Value="0.5" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="14,12,14,6" />
        </Style>
        <Style Selector="Border.panel">
            <Setter Property="Background" Value="{DynamicResource MeowsBase}" />
            <Setter Property="BorderBrush" Value="{DynamicResource MeowsLineSoft}" />
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="CornerRadius" Value="5" />
        </Style>
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource MeowsSelection}" />
        </Style>
    </UserControl.Styles>

    <DockPanel>

        <Border DockPanel.Dock="Top"
                Background="{DynamicResource MeowsCard}"
                BorderBrush="{DynamicResource MeowsLineSoft}"
                BorderThickness="0,0,0,1"
                Padding="14,10">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="{Binding CurrentPath}"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Classes="label" Text="{Binding CurrentSizeText}" />
                        <TextBlock Classes="label" Text="{Binding Status}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <CheckBox Content="{m:Tr chonk.skipsystem}"
                              IsChecked="{Binding SkipSystemFolders}"
                              FontSize="11"
                              VerticalAlignment="Center" />
                    <CheckBox Content="{m:Tr chonk.confirmdeletes}"
                              IsChecked="{Binding ConfirmDeletes}"
                              FontSize="11"
                              VerticalAlignment="Center" />
                    <Button Name="PickFolderButton" Content="{m:Tr chonk.folder}" />
                    <Button Content="{m:Tr chonk.scan}"
                            Command="{Binding ScanCommand}"
                            IsVisible="{Binding !IsScanning}" />
                    <Button Content="{m:Tr chonk.stop}"
                            Command="{Binding CancelCommand}"
                            IsVisible="{Binding IsScanning}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Top"
                Background="{DynamicResource MeowsDanger}"
                BorderBrush="{DynamicResource MeowsDangerLine}"
                BorderThickness="0,0,0,1"
                Padding="14,8"
                IsVisible="{Binding HasError}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource MeowsDangerText}" TextWrapping="Wrap" />
        </Border>

        <Panel>
        <Grid ColumnDefinitions="260,4,*,4,320">

            <!-- Drives -->
            <Border Grid.Column="0" Classes="panel" BorderThickness="0,0,1,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Classes="section" Text="{m:Tr chonk.drives}" />
                    <TextBlock DockPanel.Dock="Bottom"
                               Classes="label"
                               Margin="14,6,14,12"
                               TextWrapping="Wrap"
                               Text="{m:Tr chonk.drives.hint}" />
                    <ItemsControl ItemsSource="{Binding Drives}" Margin="8,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:DriveViewModel">
                                <Button HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Background="{DynamicResource MeowsCard}"
                                        BorderBrush="{DynamicResource MeowsLine}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="10,8"
                                        Margin="0,0,0,6"
                                        Command="{Binding $parent[UserControl].((vm:ChonkViewModel)DataContext).ScanCommand}"
                                        CommandParameter="{Binding Path}">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding UsageText}" Classes="label" />
                                        <ProgressBar Value="{Binding Fraction}" Maximum="1" Height="4" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Background="{DynamicResource MeowsRaised}" ResizeDirection="Columns" />

            <!-- What is taking up the room -->
            <DockPanel Grid.Column="2">
                <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" Margin="0,0,14,0">
                    <Button Grid.Column="0"
                            Content="{m:Tr chonk.up}"
                            Command="{Binding UpCommand}"
                            Margin="14,10,8,6"
                            Padding="10,4"
                            FontSize="11" />
                    <ScrollViewer Grid.Column="1"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled"
                                  VerticalAlignment="Center">
                        <ItemsControl ItemsSource="{Binding Crumbs}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:CrumbViewModel">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="{Binding Name}"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="4,2"
                                                FontSize="11"
                                                Command="{Binding $parent[UserControl].((vm:ChonkViewModel)DataContext).GoToCommand}"
                                                CommandParameter="{Binding}" />
                                        <TextBlock Text="›"
                                                   Opacity="0.35"
                                                   VerticalAlignment="Center"
                                                   IsVisible="{Binding !IsLast}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <TextBlock DockPanel.Dock="Top"
                           Margin="14,4,14,10"
                           Opacity="0.45"
                           TextWrapping="Wrap"
                           IsVisible="{Binding !HasResults}"
                           Text="{m:Tr chonk.empty}" />

                <ListBox Name="EntryList"
                         ItemsSource="{Binding Entries}"
                         SelectedItem="{Binding Selected}"
                         Background="Transparent"
                         BorderThickness="0"
                         Margin="8,0,8,8">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:EntryViewModel">
                            <Grid ColumnDefinitions="Auto,*,Auto,90" ColumnSpacing="10">
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Glyph}"
                                           FontSize="13"
                                           VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Spacing="3">
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    <ProgressBar Value="{Binding Fraction}" Maximum="1" Height="3" />
                                </StackPanel>
                                <TextBlock Grid.Column="2"
                                           Text="{Binding Detail}"
                                           Classes="label"
                                           VerticalAlignment="Center" />
                                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SizeText}"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Right" />
                                    <TextBlock Text="{Binding PercentText}"
                                               Classes="label"
                                               HorizontalAlignment="Right" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <GridSplitter Grid.Column="3" Background="{DynamicResource MeowsRaised}" ResizeDirection="Columns" />

            <!-- What you picked -->
            <Border Grid.Column="4" Classes="panel" BorderThickness="1,0,0,0">
                <ScrollViewer Padding="16,12">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{m:Tr chonk.selected}" FontWeight="SemiBold" FontSize="13" />

                        <TextBlock Text="{m:Tr chonk.nothingselected}"
                                   Classes="label"
                                   IsVisible="{Binding Selected, Converter={x:Static ObjectConverters.IsNull}}" />

                        <StackPanel Spacing="6"
                                    IsVisible="{Binding Selected, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <TextBlock Text="{Binding Selected.Name}" TextWrapping="Wrap" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Selected.SizeText}" FontSize="20" />
                            <TextBlock Text="{Binding Selected.Detail}" Classes="label" />
                            <TextBlock Text="{Binding Selected.Path}"
                                       Classes="label"
                                       TextWrapping="Wrap" />

                            <TextBlock Text="{m:Tr chonk.identifying}"
                                       Classes="label"
                                       Margin="0,6,0,0"
                                       IsVisible="{Binding IsIdentifying}" />

                            <!-- What it is, and why it thinks so. The reasons matter as much as
                                 the answer, because this is the panel someone reads before
                                 deleting 40 GB they cannot identify. -->
                            <Border IsVisible="{Binding HasIdentity}"
                                    Background="{DynamicResource MeowsCard}"
                                    BorderBrush="{DynamicResource MeowsLine}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10,8"
                                    Margin="0,6,0,0">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{Binding IdentityHeadline}"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap" />

                                    <TextBlock Text="{Binding IdentityAdvice}"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Opacity="0.75" />

                                    <Border Background="{DynamicResource MeowsWarn}"
                                            BorderBrush="{DynamicResource MeowsWarnLine}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="7,4"
                                            IsVisible="{Binding IdentityIsWarning}">
                                        <TextBlock Text="{m:Tr chonk.secondlook}"
                                                   Foreground="{DynamicResource MeowsWarnText}"
                                                   FontSize="11"
                                                   TextWrapping="Wrap" />
                                    </Border>

                                    <ItemsControl ItemsSource="{Binding Evidence}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <TextBlock Text="{Binding}"
                                                           Classes="label"
                                                           TextWrapping="Wrap"
                                                           Margin="0,2,0,0" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Button Content="{m:Tr chonk.openexplorer}"
                                    Command="{Binding ExploreCommand}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Margin="0,6,0,0" />

                            <Button Content="{m:Tr chonk.recycle}"
                                    Command="{Binding DeleteCommand}"
                                    Background="{DynamicResource MeowsDanger}"
                                    BorderBrush="{DynamicResource MeowsDangerLine}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center" />

                            <TextBlock Classes="label"
                                       TextWrapping="Wrap"
                                       Text="{m:Tr chonk.wholefolder}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

        </Grid>

        <!-- The safeguard. Over everything, so the question cannot be missed or clicked past. -->
        <Border IsVisible="{Binding IsAsking}" Background="{DynamicResource MeowsVeil}">
            <Border Background="{DynamicResource MeowsCard}"
                    BorderBrush="{DynamicResource MeowsDangerLine}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20,16"
                    MaxWidth="440"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel Spacing="10">
                    <TextBlock Text="{Binding ConfirmPrompt}"
                               FontWeight="SemiBold"
                               FontSize="15"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ConfirmDetail}"
                               Opacity="0.7"
                               FontSize="12"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding PendingDelete.Path}"
                               Opacity="0.4"
                               FontSize="11"
                               TextWrapping="Wrap" />

                    <CheckBox Content="{m:Tr chonk.dontask}"
                              IsChecked="{Binding DoNotAskAgain}"
                              FontSize="11"
                              Margin="0,4,0,0" />

                    <Grid ColumnDefinitions="*,8,*">
                        <Button Grid.Column="0"
                                Content="{m:Tr chonk.cancel}"
                                Command="{Binding CancelDeleteCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center" />
                        <Button Grid.Column="2"
                                Content="{m:Tr chonk.recycle}"
                                Command="{Binding ConfirmDeleteCommand}"
                                Background="{DynamicResource MeowsDanger}"
                                BorderBrush="{DynamicResource MeowsDangerLine}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>
        </Border>
        </Panel>

    </DockPanel>

</UserControl>
