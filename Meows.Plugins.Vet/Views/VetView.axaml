<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Meows.Plugins.Vet.ViewModels"
             xmlns:m="using:Meows.Plugins.Abstractions"
             x:Class="Meows.Plugins.Vet.Views.VetView"
             x:DataType="vm:VetViewModel">

    <UserControl.Styles>
        <Style Selector="TextBlock.label">
            <Setter Property="Opacity" Value="0.5" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style Selector="TextBlock.section">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Opacity" Value="0.5" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="CornerRadius" Value="5" />
        </Style>
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource MeowsSelection}" />
        </Style>
        <Style Selector="Border.marker">
            <Setter Property="Width" Value="4" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
        </Style>
    </UserControl.Styles>

    <DockPanel>

        <Border DockPanel.Dock="Top"
                Background="{DynamicResource MeowsCard}"
                BorderBrush="{DynamicResource MeowsLineSoft}"
                BorderThickness="0,0,0,1"
                Padding="14,10">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Classes="label" Text="{Binding Status}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Content="{m:Tr vet.checkup}" Command="{Binding CheckupCommand}" />
                    <Button Content="{m:Tr vet.export}" Command="{Binding ExportCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Top"
                Background="{DynamicResource MeowsDanger}"
                BorderBrush="{DynamicResource MeowsDangerLine}"
                BorderThickness="0,0,0,1"
                Padding="14,8"
                IsVisible="{Binding HasError}">
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{DynamicResource MeowsDangerText}"
                       TextWrapping="Wrap" />
        </Border>

        <ScrollViewer>
            <StackPanel Margin="16" Spacing="16" MaxWidth="700" HorizontalAlignment="Left">

                <StackPanel Spacing="4">
                    <TextBlock Classes="section" Text="{m:Tr vet.drives}" />
                    <TextBlock Classes="label"
                               Text="{m:Tr vet.empty}"
                               TextWrapping="Wrap"
                               IsVisible="{Binding IsEmpty}" />
                    <ListBox Name="DriveList"
                             ItemsSource="{Binding Drives}"
                             SelectedItem="{Binding Selected}"
                             Background="Transparent"
                             BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:DriveViewModel">
                                <Grid ColumnDefinitions="4,Auto,*,Auto" ColumnSpacing="10">
                                    <Border Grid.Column="0"
                                            Classes="marker"
                                            Background="{DynamicResource MeowsDangerStrong}"
                                            IsVisible="{Binding IsLow}" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Name}"
                                               FontWeight="SemiBold"
                                               FontSize="20"
                                               VerticalAlignment="Center" />
                                    <ProgressBar Grid.Column="2"
                                                 Minimum="0"
                                                 Maximum="1"
                                                 Value="{Binding FreeFraction}"
                                                 VerticalAlignment="Center"
                                                 MinHeight="10" />
                                    <TextBlock Grid.Column="3"
                                               Text="{Binding RoomText}"
                                               FontSize="11"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Classes="section" Text="{m:Tr vet.reboot}" />
                    <TextBlock Text="{Binding RebootText}" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <TextBlock Grid.Column="0"
                                   Classes="section"
                                   Text="{m:Tr vet.backup}"
                                   VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <Button Content="{m:Tr vet.backup.set}"
                                    Command="{Binding SetBackupCommand}"
                                    FontSize="11" />
                            <Button Content="{m:Tr vet.backup.clear}"
                                    Command="{Binding ClearBackupCommand}"
                                    FontSize="11" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding BackupText}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding BackupAgeText}" Classes="label" TextWrapping="Wrap" />
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <TextBlock Grid.Column="0"
                                   Classes="label"
                                   Text="{m:Tr vet.warn}"
                                   VerticalAlignment="Center" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding WarnDaysText}"
                                 Width="80"
                                 HorizontalAlignment="Left" />
                    </Grid>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

    </DockPanel>

</UserControl>
