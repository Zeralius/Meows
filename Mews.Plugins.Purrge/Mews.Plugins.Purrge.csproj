<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

        <!-- Debug drops into the folder the running shell scans; Release goes to bin so a
             Release build cannot replace the plugin a Debug shell is loading. -->
        <OutputPath Condition="'$(Configuration)' == 'Debug'">$(MSBuildThisFileDirectory)..\plugins\Mews.Plugins.Purrge\</OutputPath>
        <OutputPath Condition="'$(Configuration)' != 'Debug'">$(MSBuildThisFileDirectory)bin\$(Configuration)\</OutputPath>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Avalonia" Version="12.1.1" ExcludeAssets="runtime" />
      <ProjectReference Include="..\Mews.Plugins.Abstractions\Mews.Plugins.Abstractions.csproj"
                        Private="false"
                        ExcludeAssets="runtime" />
    </ItemGroup>

</Project>
